%!PS
%%Title: florilegium.ps
%%Creator: florilegium
%%Copyright: (c) 2026 Kevin Raymond, MIT License (below)
%%BoundingBox: 0 0 595 842
%%DocumentNeededResources: font Times-Roman Times-Bold Times-Italic
%
% florilegium.ps -- a Delft-blue floral page margin, grown by the PostScript
% interpreter that prints it. No images and no precomputed paths: every petal,
% leaf and stem below is computed from a seed while the page is interpreted.
% It is a port of florilegium's Lua (ink.lua, flora.lua, grow.lua) to PostScript.
%
%   gs -dALLOWPSTRANSPARENCY -dSeed=7 -sDEVICE=pdfwrite -o garden.pdf florilegium.ps
%   gs -dALLOWPSTRANSPARENCY -dSeed=7 -sDEVICE=png16m -r100 -dGraphicsAlphaBits=4 -o page-%d.png florilegium.ps
%
% -dSeed=N picks the garden (1 to 250000; a larger seed wraps around), and
% without one the interpreter's clock picks it, so every print grows a new
% garden. -dAge=0..1 sets the season (0 spring, 0.5 summer, 1 autumn), and
% -dNoVisitors leaves out the butterflies, bees, snail and bird. A printer
% takes no -d options: add a line such as /Seed 7 def after the first line.
% postscript/README.md in the repository (below) has more; check.sh tests it.
%
% Transparency: PostScript has none, and the watercolor look lives on it
% (washes multiplied over washes, white streaks lifted out). Ghostscript
% has it as an extension, enabled by -dALLOWPSTRANSPARENCY. Without it (or on a
% printer) every translucent fill is mixed with the color it lands on, guessed
% as the last opaque wash, and painted opaque: flatter, but the same garden.

% https://github.com/kevinraymond/florilegium
%
% MIT License
%
% Copyright (c) 2026 Kevin Raymond
%
% Permission is hereby granted, free of charge, to any person obtaining a copy
% of this software and associated documentation files (the "Software"), to deal
% in the Software without restriction, including without limitation the rights
% to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
% copies of the Software, and to permit persons to whom the Software is
% furnished to do so, subject to the following conditions:
%
% The above copyright notice and this permission notice shall be included in all
% copies or substantial portions of the Software.
%
% THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
% IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
% FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
% AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
% LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
% OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
% SOFTWARE.

% ---------------------------------------------------------------- settings
% -dName=value arrives as a number, -dName alone as true, -sName=value as a
% string; main reads each through optnum or optbool, so any of them works.
/Seed where { pop } { /Seed 0 def } ifelse
/Age where { pop } { /Age -1 def } ifelse
/NoVisitors where { pop } { /NoVisitors false def } ifelse
/FloCheck where { pop } { /FloCheck false def } ifelse

/florilegium 900 dict def
florilegium begin

% ---------------------------------------------------------------- numbers
/CM 72 2.54 div def                                        % bp per cm
/min { 2 copy gt { exch } if pop } bind def
/max { 2 copy lt { exch } if pop } bind def
/clamp { 3 1 roll max min } bind def                       % x lo hi -> x'
/lerp { 3 1 roll 1 index sub 3 -1 roll mul add } bind def  % a b t -> a+(b-a)t
/pw { exch dup 0 le { pop pop 0 } { exch exp } ifelse } bind def   % x e -> x^e (0 if x<=0)
/fmod { 2 copy div floor mul sub } bind def                % x y -> x - y*floor(x/y)
/smoothstep { 2 index sub 3 1 roll exch sub div 0 1 clamp dup dup mul exch 2 mul 3 exch sub mul } bind def  % a b x
/dist { 3 -1 roll sub dup mul 3 1 roll sub dup mul add sqrt } bind def          % ax ay bx by -> d
/norm {                                                    % x y -> unit vector (0 1 if tiny)
  2 copy dup mul exch dup mul add sqrt dup 1e-9 lt
  { pop pop pop 0 1 } { dup 3 1 roll div 3 1 roll div exch } ifelse } bind def
/deg { 2 copy abs exch abs add 1e-12 lt { pop pop 0 } { exch atan } ifelse } bind def  % x y -> degrees
/P { aload pop } bind def                                  % [x y] -> x y

% options: o key default opt -> value; optp takes a procedure for the default
% and runs it only when the key is missing (so a default may draw from an rng)
/opt { 3 1 roll 2 copy known { get exch pop } { pop pop } ifelse } bind def
/optp { 3 1 roll 2 copy known { get exch pop } { pop pop exec } ifelse } bind def
/NOOPT 0 dict def

% ---------------------------------------------------------------- random
% Park-Miller "minimal standard" generator by Schrage's method: exact in 32-bit
% integers on any interpreter. An rng is a one-element array holding the state;
% R.fork makes an independent stream, so a change inside a primitive does not
% move the layout that called it.
/R.u {                                                     % rng -> u in (0,1)
  dup 0 get dup 127773 mod 16807 mul exch 127773 idiv 2836 mul sub
  dup 0 le { 2147483647 add } if
  dup 3 1 roll 0 exch put 2147483647 div } bind def
/R.new {                                                   % seed -> rng
  abs dup 2147483646 div floor 2147483646 mul sub cvi 1 add 1 array astore
  dup R.u pop dup R.u pop } bind def
/R.range { 1 index sub 3 -1 roll R.u mul add } bind def    % rng a b -> a..b
/R.sym { exch R.u 2 mul 1 sub mul } bind def               % rng a -> -a..a
/R.int { 1 index sub 1 add 3 -1 roll R.u mul floor cvi add } bind def   % rng a b -> a..b integer
/R.chance { exch R.u gt } bind def                         % rng p -> bool
/R.fork { dup R.u pop 0 get 1234567891 xor
  dup 1 lt 1 index 2147483646 gt or { pop 1 } if 1 array astore } bind def

% ---------------------------------------------------------------- noise
% 1-D gradient noise with a seeded gradient table, smooth, roughly in [-1,1].
% noise1 returns a procedure x -> value; fbm1 sums `oct` octaves of it.
/noise1eval {                                              % x g -> v
  exch dup floor dup 3 1 roll sub 3 1 roll cvi
  2 copy 255 and get 3 index mul
  3 1 roll 1 add 255 and get 2 index 1 sub mul
  1 index sub 3 -1 roll dup dup mul exch 2 mul 3 exch sub mul mul add 2 mul } bind def
/noise1 { [ exch 256 { dup 1 R.sym exch } repeat pop ] [ exch /noise1eval cvx ] cvx } bind def
/fbmeval { 6 dict begin /_ns exch def /_x exch def /_v 0 def /_a 1 def /_f 1 def /_k 1 def
  _ns { _x _f mul 17 _k mul add exch exec _a mul _v add /_v exch def
        /_a _a 0.5 mul def /_f _f 2 mul def /_k _k 1 add def } forall
  _v end } bind def
/fbm1 { [ 3 1 roll { dup noise1 exch } repeat pop ] [ exch /fbmeval cvx ] cvx } bind def  % rng oct -> proc

% ---------------------------------------------------------------- color
% A tone ramp derived from the ink color: tone(0) is the darkest navy, tone(1)
% the palest mist, all at the hue of the ink, computed in OKLCH so the light end
% stays blue instead of turning gray. 101 colors, computed once. OKLCH is Oklab
% in polar form; Oklab and its matrices are Bjorn Ottosson's ("A perceptual
% color space for image processing", 2020, public domain).
/srgbdec { dup 0.04045 le { 12.92 div } { 0.055 add 1.055 div 2.4 exp } ifelse } bind def
/srgbenc { dup 0.0031308 le { 12.92 mul } { 1 2.4 div exp 1.055 mul 0.055 sub } ifelse } bind def
/cbrt { dup 0 lt { neg 1 3 div exp neg } { 1 3 div exp } ifelse } bind def
/cube { dup dup mul mul } bind def
/rgb2oklch {                                               % r g b -> L C h
  8 dict begin srgbdec /b exch def srgbdec /g exch def srgbdec /r exch def
  /l 0.4122214708 r mul 0.5363325363 g mul add 0.0514459929 b mul add cbrt def
  /m 0.2119034982 r mul 0.6806995451 g mul add 0.1073969566 b mul add cbrt def
  /s 0.0883024619 r mul 0.2817188376 g mul add 0.6299787005 b mul add cbrt def
  /A 1.9779984951 l mul 2.4285922050 m mul sub 0.4505937099 s mul add def
  /B 0.0259040371 l mul 0.7827717662 m mul add 0.8086757660 s mul sub def
  0.2104542553 l mul 0.7936177850 m mul add 0.0040720468 s mul sub
  A A mul B B mul add sqrt A B deg end } bind def
/oklch2rgb {                                               % L C h -> r g b true | false (out of gamut)
  12 dict begin /h exch def /C exch def /L exch def
  /A C h cos mul def /B C h sin mul def
  /l L 0.3963377774 A mul add 0.2158037573 B mul add cube def
  /m L 0.1055613458 A mul sub 0.0638541728 B mul sub cube def
  /s L 0.0894841775 A mul sub 1.2914855480 B mul sub cube def
  /r 4.0767416621 l mul 3.3077115913 m mul sub 0.2309699292 s mul add def
  /g -1.2684380046 l mul 2.6097574011 m mul add 0.3413193965 s mul sub def
  /b -0.0041960863 l mul 0.7034186147 m mul sub 1.7076147010 s mul add def
  r -1e-4 lt g -1e-4 lt or b -1e-4 lt or r 1.0001 gt or g 1.0001 gt or b 1.0001 gt or
  { false } { r 0 1 clamp srgbenc g 0 1 clamp srgbenc b 0 1 clamp srgbenc true } ifelse
  end } bind def
/oklchc {                                                  % L C h -> r g b, chroma reduced into gamut
  3 copy oklch2rgb { 6 3 roll pop pop pop } {
    6 dict begin /h exch def /C exch def /L exch def /lo 0 def /hi C def
    18 { /mid lo hi add 2 div def L mid h oklch2rgb { pop pop pop /lo mid def } { /hi mid def } ifelse } repeat
    L lo h oklch2rgb pop end } ifelse } bind def
% the stops: t, lightness, chroma, hue drift (violet in the darks, cyan in the
% lights, as ultramarine does when it is thinned with water)
/STOPS [ [0.00 0.25 0.105 6] [0.18 0.35 0.150 3] [0.38 0.47 0.175 0]
         [0.58 0.60 0.145 -3] [0.80 0.77 0.080 -6] [1.00 0.92 0.030 -8] ] def
/REFC 0.175 def                                            % chroma of the default ink at the cobalt stop
/buildramp {                                               % r g b -> array of 101 colors
  10 dict begin rgb2oklch /hue exch def REFC div 0.15 1.3 clamp /ck exch def pop
  [ 0 1 100 { 100 div /t exch def
      /k 0 def { STOPS k 1 add get 0 get t lt { /k k 1 add def } { exit } ifelse } loop
      /sa STOPS k get def /sb STOPS k 1 add get def
      /u t sa 0 get sub sb 0 get sa 0 get sub div def
      sa 1 get sb 1 get u lerp  sa 2 get sb 2 get u lerp ck mul  hue sa 3 get sb 3 get u lerp add
      oklchc 3 array astore } for ]
  end } bind def

/INK [16#24 255 div 16#56 255 div 16#C4 255 div] def      % #2456C4
/ACCENT [0.71 0.40 0.18] def                               % copper
/RAMP INK aload pop buildramp def
/ACCENTRAMP null def
/white [1 1 1] def
/paper [0.995 0.993 0.985] def
/LIFT 0 def                                                % ghosts: tone t -> t + (1-t) LIFT

/tone { dup 1 exch sub LIFT mul add 100 mul 0.5 add floor cvi 0 100 clamp RAMP exch get } bind def  % t -> color
/accent { 1 dict begin /k exch def                         % k -> copper, k>0 lighter, k<0 darker
  k 0 ge { [ ACCENT { dup 1 exch sub k mul add } forall ] } { [ ACCENT { 1 k add mul } forall ] } ifelse end } bind def
/inaccent {                                                % proc -> ; paint proc with a ramp at the copper's hue
  ACCENTRAMP null eq { /ACCENTRAMP ACCENT aload pop buildramp store } if
  RAMP exch /RAMP ACCENTRAMP store exec /RAMP exch store } bind def
/pale { LIFT 3 1 roll exch /LIFT exch store exec /LIFT exch store } bind def   % level proc -> ; paint proc pale
/isghost { LIFT 0.3 gt } bind def

% ---------------------------------------------------------------- transforms
% A drawing is made in a local frame (centimeters) under the current
% transformation matrix, which is PostScript's own: translate, rotate and scale
% are the native operators. ipush/ipop save and restore only the matrix (gsave
% would also throw away the path being built).
/MS 200 array def /MSP 0 def
/ipush { MS MSP matrix currentmatrix put /MSP MSP 1 add store } bind def
/ipop { /MSP MSP 1 sub store MS MSP get setmatrix } bind def
/DEF matrix def /DETDEF 1 def                              % the page's default matrix (bp), set by startpage
% centimeters per local unit, for level-of-detail decisions
/unit { matrix currentmatrix dup 0 get 1 index 3 get mul exch dup 1 get exch 2 get mul sub abs DETDEF div sqrt CM div } bind def
/lod { unit } bind def
/topage { transform DEF itransform CM div exch CM div exch } bind def   % x y -> page cm

% ---------------------------------------------------------------- output
% Motifs are drawn in the order they grow but must be painted back to front,
% so nothing is painted while the garden grows: every fill, stroke and clip is
% captured with pathforall (in page coordinates) into a procedure, appended to
% one of the numbered layers, and the layers are run in order at the end.
/LAYERS 100 array def /CUR 5 def
/layer { /CUR exch store } bind def
/lput {                                                    % proc -> ; append to the current layer
  LAYERS CUR get dup null eq { pop 2 dict dup /n 0 put dup /a 1024 array put LAYERS CUR 2 index put } if
  dup /n get 1 index /a get length ge
  { dup /a get dup length 2 mul array dup 0 4 -1 roll putinterval 1 index exch /a exch put } if
  dup /a get 1 index /n get 4 -1 roll put
  dup /n get 1 add /n exch put } bind def
/pathops { gsave DEF setmatrix
  { /moveto load } { /lineto load } { /curveto load } { /closepath load } pathforall grestore } bind def

/TRANSP /.setfillconstantalpha where { pop true } { false } ifelse def
/BACK paper def                                            % the last opaque color: the backdrop, without transparency
/mixed { 3 dict begin /m exch def /o exch def /c exch def  % c op mult -> c', opaque, as if painted over BACK
  [ 0 1 2 { dup c exch get exch BACK exch get
      m { exch 1 sub o mul 1 add mul } { 1 o sub mul exch o mul add } ifelse } for ] end } bind def
/ifill {                                                   % c op mult -> ; fill the current path
  3 dict begin /_m exch def /_o exch def /_c exch def
  /_a _o 0.995 lt _m or def
  _a not { /BACK _c store } if
  _a TRANSP and
  { [ /gsave load _o 100 mul round 100 div /.setfillconstantalpha load _m { /Multiply /.setblendmode load } if
      _c aload pop /setrgbcolor load pathops /fill load /grestore load ] }
  { [ _a { _c _o _m mixed } { _c } ifelse aload pop /setrgbcolor load pathops /fill load ] } ifelse
  cvx lput newpath end } bind def
/istroke {                                                 % c w op mult dash -> ; dash: null or [array offset]
  5 dict begin /_d exch def /_m exch def /_o exch def /_w exch def /_c exch def
  /_a _o 0.995 lt _m or def
  [ /gsave load
    _a TRANSP and { _o 100 mul round 100 div dup /.setstrokeconstantalpha load   % Ghostscript's PDF writer reads the
                    /.setfillconstantalpha load                                  % stroke alpha, its rasterizer the fill alpha
                    _m { /Multiply /.setblendmode load } if _c }
                  { _a { _c _o _m mixed } { _c } ifelse } ifelse
    aload pop /setrgbcolor load _w /setlinewidth load
    _d null ne { _d aload pop /setdash load } if
    pathops /stroke load /grestore load ] cvx lput newpath end } bind def
/fillc { 1 false ifill } bind def                          % c ->
/strokec { 1 false null istroke } bind def                 % c w ->   (w in bp)
/strokea { false null istroke } bind def                   % c w op ->
/iclip { [ /gsave load pathops /clip load /newpath load ] cvx lput newpath } bind def
/iunclip { [ /grestore load ] cvx lput /BACK paper store } bind def
/iflood { 4 dict begin /y1 exch def /x1 exch def /y0 exch def /x0 exch def  % c x0 y0 x1 y1 -> fill a box
  x0 y0 moveto x1 y0 lineto x1 y1 lineto x0 y1 lineto closepath end fillc } bind def
/paintlayers {                                             % run every layer, back to front
  DEF setmatrix 1 setlinecap 1 setlinejoin
  0 1 99 { LAYERS exch get dup null ne { dup /a get exch /n get 0 exch getinterval { exec } forall } { pop } ifelse } for
  /LAYERS 100 array store } bind def

% ---------------------------------------------------------------- paths
% Points are [x y] arrays, polylines arrays of them. Helpers that call back into
% a procedure they were given keep their own variables in names starting with
% an underscore, so the callback still sees its caller's variables.
/poly { exch dup 0 get P moveto dup length 1 sub 1 exch getinterval { P lineto } forall { closepath } if } bind def  % pts closed
/_at { _cl { _n add _n mod } { 0 max _n 1 sub min } ifelse _p exch get } bind def
/smooth {                                                  % pts closed tension -> Catmull-Rom through the points, as Beziers
  14 dict begin /_k exch 6 div def /_cl exch def /_p exch def /_n _p length def
  _n 3 lt { _p _cl poly } {
    _p 0 get P moveto
    0 1 _cl { _n 1 sub } { _n 2 sub } ifelse { /_i exch def
      _i 1 sub _at P /_y0 exch def /_x0 exch def  _i _at P /_y1 exch def /_x1 exch def
      _i 1 add _at P /_y2 exch def /_x2 exch def  _i 2 add _at P /_y3 exch def /_x3 exch def
      _x1 _x2 _x0 sub _k mul add  _y1 _y2 _y0 sub _k mul add
      _x2 _x3 _x1 sub _k mul sub  _y2 _y3 _y1 sub _k mul sub  _x2 _y2 curveto } for
    _cl { closepath } if } ifelse end } bind def
/circle { 4 dict begin /r exch def /y exch def /x exch def /k 0.5523 r mul def   % x y r
  x r add y moveto
  x r add y k add  x k add y r add  x y r add curveto
  x k sub y r add  x r sub y k add  x r sub y curveto
  x r sub y k sub  x k sub y r sub  x y r sub curveto
  x k add y r sub  x r add y k sub  x r add y curveto closepath end } bind def
/normals { 3 dict begin /_p exch def /_n _p length def     % pts -> unit normals
  [ 0 1 _n 1 sub { /_i exch def
      _p _i 1 add _n 1 sub min get P _p _i 1 sub 0 max get P
      3 -1 roll exch sub 3 1 roll sub
      2 copy dup mul exch dup mul add sqrt dup 1e-9 lt { pop 1 } if
      dup 3 1 roll div 3 1 roll div neg exch 2 array astore } for ] end } bind def
/arclen { 3 dict begin /_p exch def /_acc 0 def            % pts -> cumulative lengths, total
  [ 0 1 1 _p length 1 sub { /_i exch def _p _i get P _p _i 1 sub get P dist _acc add dup /_acc exch def } for ]
  _acc end } bind def
/ribbon {                                                  % pts width -> outline; width: u -> full width at u
  16 dict begin /_wf exch def /_p exch def /_nr _p normals def _p arclen /_L exch def /_s exch def
  /_n _p length def /_lf _n array def /_rt _n array def
  0 1 _n 1 sub { /_i exch def
    _L 0 gt { _s _i get _L div } { 0 } ifelse _wf 2 div /_w exch def
    _p _i get P /_y exch def /_x exch def _nr _i get P /_ny exch def /_nx exch def
    _lf _i [ _x _nx _w mul add _y _ny _w mul add ] put
    _rt _i [ _x _nx _w mul sub _y _ny _w mul sub ] put } for
  [ _lf aload pop _n 1 sub -1 0 { _rt exch get } for ] end } bind def
% a tapered stroke along one cubic Bezier as a closed outline of two Beziers:
% the control points pushed out along the curve's normals by half the width
% at their parameter (w0 at the start, w1 at the end)
/tnrm { 2 copy dup mul exch dup mul add sqrt dup 1e-9 lt
  { pop pop pop 0 0 } { dup 3 1 roll div 3 1 roll div exch neg exch } ifelse } bind def   % dx dy -> normal
/taper { 22 dict begin                                     % x0 y0 x1 y1 x2 y2 x3 y3 w0 w1 ->
  /w1 exch def /w0 exch def /y3 exch def /x3 exch def /y2 exch def /x2 exch def /y1 exch def /x1 exch def /y0 exch def /x0 exch def
  x1 x0 sub y1 y0 sub tnrm /n0y exch def /n0x exch def
  x2 x0 sub y2 y0 sub tnrm /n1y exch def /n1x exch def
  x3 x1 sub y3 y1 sub tnrm /n2y exch def /n2x exch def
  x3 x2 sub y3 y2 sub tnrm /n3y exch def /n3x exch def
  /h0 w0 2 div def /h1 2 w0 mul w1 add 6 div def /h2 w0 2 w1 mul add 6 div def /h3 w1 2 div def
  x0 n0x h0 mul add y0 n0y h0 mul add moveto
  x1 n1x h1 mul add y1 n1y h1 mul add  x2 n2x h2 mul add y2 n2y h2 mul add  x3 n3x h3 mul add y3 n3y h3 mul add curveto
  x3 n3x h3 mul sub y3 n3y h3 mul sub lineto
  x2 n2x h2 mul sub y2 n2y h2 mul sub  x1 n1x h1 mul sub y1 n1y h1 mul sub  x0 n0x h0 mul sub y0 n0y h0 mul sub curveto
  closepath end } bind def
/sample { 5 dict begin /_v1 exch def /_v0 exch def /_n exch def /_f exch def   % f n v0 v1 -> n+1 points of f(v)
  [ 0 1 _n { _n div _v1 _v0 sub mul _v0 add _f 2 array astore } for ] end } bind def
/bez3eval { 14 dict begin                                  % v x0 y0 x1 y1 x2 y2 x3 y3 -> x y
  /y3 exch def /x3 exch def /y2 exch def /x2 exch def /y1 exch def /x1 exch def /y0 exch def /x0 exch def /v exch def
  /u 1 v sub def /a u u mul u mul def /b 3 u mul u mul v mul def /c 3 u mul v mul v mul def /d v v mul v mul def
  a x0 mul b x1 mul add c x2 mul add d x3 mul add  a y0 mul b y1 mul add c y2 mul add d y3 mul add end } bind def
/bezier3 { [ 9 1 roll /bez3eval cvx ] cvx } bind def       % x0 y0 x1 y1 x2 y2 x3 y3 -> procedure v -> x y
/BLADEC null def /BLADEN null def
% a blade: a closed outline around a spine, half-widths wl(v) and wr(v) on each
% side and an edge perturbation edge(v, side) added along the normal (or null).
% Used for petals, leaves, sepals, buds. Leaves the spine and its normals in
% BLADEC and BLADEN.
/blade {                                                   % spine n wl wr edge -> outline
  20 dict begin /_e exch def /_wr exch def /_wl exch def /_n exch def /_sp exch def
  /_c /_sp load _n 0 1 sample def
  /_nr _c normals def
  /_lf _n 1 add array def /_rt _n 1 add array def
  0 1 _n { /_i exch def /_v _i _n div def
    /_e load null ne { _v 1 _e _v -1 _e } { 0 0 } ifelse /_er exch def /_el exch def
    _v _wl _el add 0 max /_a exch def
    _v _wr _er add 0 max /_b exch def
    _c _i get P /_y exch def /_x exch def _nr _i get P /_ny exch def /_nx exch def
    _lf _i [ _x _nx _a mul add _y _ny _a mul add ] put
    _rt _i [ _x _nx _b mul sub _y _ny _b mul sub ] put } for
  /BLADEC _c store /BLADEN _nr store
  [ _lf aload pop _n 1 sub -1 1 { _rt exch get } for ] end } bind def
/blob {                                                    % rng x y rx ry rough n -> an irregular closed ring of n points
  16 dict begin /_N exch def /_ro exch def /_ry exch def /_rx exch def /_y exch def /_x exch def /_r exch def
  /_ph _r 0 360 R.range def /_ph2 _r 0 360 R.range def /_rot _r 0 360 R.range def
  [ 0 1 _N 1 sub { 360 mul _N div /_a exch def
      /_k 1 _ro 0.6 2 _a mul _ph add sin mul 0.4 3 _a mul _ph2 add sin mul add mul add _ro 0.5 mul _r 1 R.sym mul add def
      /_px _rx _k mul _a cos mul def /_py _ry _k mul _a sin mul def
      _x _px _rot cos mul add _py _rot sin mul sub
      _y _px _rot sin mul add _py _rot cos mul add 2 array astore } for ] end } bind def

% ================================================================ the primitives
% Every primitive draws in its own local frame (centimeters, origin at its base
% or center, pointing along +y unless noted) and takes an rng, so no two are
% alike. Painting is layered like a watercolor: a flat wash, darker blotches
% multiplied over it, pooling at the edges, pale streaks lifted out, a few fine
% ink lines on top. There are almost no outlines; edges are made by the wash.

% ---------------------------------------------------------------- washes
/speck { 4 dict begin /a exch def /r exch def /y exch def /x exch def   % x y r a -> a small rhomb
  [ [x r a cos mul add y r a sin mul add] [x 0.6 r mul a sin mul sub y 0.6 r mul a cos mul add]
    [x r a cos mul sub y r a sin mul sub] [x 0.6 r mul a sin mul add y 0.6 r mul a cos mul sub] ] true poly end } bind def
% granulated watercolor inside the current clip: darker and lighter blotches
% over a box, then fine specks
/mottle {                                                  % rng x0 y0 x1 y1 n size dark light specks ->
  14 dict begin /sp exch def /light exch def /dark exch def /sz exch def /n exch def
  /y1 exch def /x1 exch def /y0 exch def /x0 exch def /rng exch def
  n { /x rng x0 x1 R.range def /y rng y0 y1 R.range def /r sz rng 0.5 1.4 R.range mul def
      rng x y r r rng 0.5 1 R.range mul 0.35 7 blob true 1 smooth
      rng 0.6 R.chance { dark rng 0.06 R.sym add tone rng 0.10 0.22 R.range true ifill }
                       { light rng 0.06 R.sym add tone rng 0.12 0.26 R.range false ifill } ifelse } repeat
  sp 0 gt isghost not and {
    sp { rng x0 x1 R.range rng y0 y1 R.range sz rng 0.03 0.08 R.range mul rng 0 180 R.range speck } repeat
    dark 0.08 sub tone rng 0.3 0.5 R.range true ifill } if
  end } bind def
/streakw { 3 -1 roll dup 0.12 lt { dup 5 mul 0.4 add } { 1 } ifelse 4 1 roll lerp mul } bind def  % u w0 w1 -> w
% a tapered ribbon along a curve f(v), widths w0 at the start and w1 at the end
/streak { 8 dict begin /_mu exch def /_op exch def /_c exch def /_w1 exch def /_w0 exch def /_n exch def /_f exch def
  /_f load _n 0 1 sample [ _w0 _w1 /streakw cvx ] cvx ribbon true 1 smooth _c _op _mu ifill end } bind def   % f n w0 w1 c op mult
% the same along one cubic Bezier: much cheaper
/streak3 { 4 dict begin /_mu exch def /_op exch def /_c exch def taper _c _op _mu ifill end } bind def  % x0..y3 w0 w1 c op mult

% ---------------------------------------------------------------- petal
% half-width of an obovate petal: narrow claw, widest at 0.62, elliptical cap
/roundhalfeval { exch dup 0.62 lt                          % v W -> half-width
  { 0.62 div 90 mul sin 1.3 pw 0.84 mul 0.16 add mul }
  { 0.62 sub 0.38 div dup mul 1 exch sub 0 max sqrt mul } ifelse } bind def
/roundhalf { [ exch /roundhalfeval cvx ] cvx } bind def   % W -> procedure v -> half-width

% Base at the origin, pointing +y, length 1. Options: /w (half-width), /tone,
% /streaks, /bend (tip offset), /shape (/round or /pointed), /heart (pale base).
/petal { 40 dict begin /o exch def /rng exch def           % rng o ->
  /pointed o /shape /round opt /pointed eq def
  /W o /w { pointed { rng 0.15 0.2 R.range } { rng 0.40 0.48 R.range } ifelse } optp def
  /bend o /bend { rng 0.08 R.sym } optp def
  /t0 o /tone { rng 0.34 0.42 R.range } optp def
  /u lod def
  /fine u 0.45 gt isghost not and def
  /wave rng 3 fbm1 def
  /notch pointed not { rng 0.4 R.chance } { false } ifelse { rng 0.03 0.06 R.range } { 0 } ifelse def
  /spine { dup dup mul bend mul exch } def
  pointed { /half { dup 0.8 pw 180 mul sin 0.85 pw W 2 mul mul exch 0.3 mul 1 exch sub mul } def }
          { /half W roundhalf def } ifelse
  /edge { 0 gt { 0 } { 40 } ifelse 1 index 6 mul add wave
    pointed { 0.012 } { 0.03 } ifelse mul 1 index mul
    notch 0 gt 2 index 0.9 gt and { exch 0.9 sub 10 mul dup 1 exch sub mul notch mul sub } { exch pop } ifelse } def
  /outline /spine load u 0.5 gt { 28 } { 18 } ifelse /half load dup /edge load blade def
  outline true 1 smooth iclip
    t0 tone -1 -0.1 1 1.2 iflood
    o /heart true opt {                                    % the heart of the flower is pale
      1 1 8 { /k exch def rng 0 0 W 0.25 0.1 k mul add mul 0.06 0.065 k mul add 0.28 9 blob true 1 smooth white 0.1 false ifill } for } if
    rng W -1.2 mul 0.12 W 1.2 mul 1.05 fine { 15 } { 6 } ifelse pointed { 0.06 } { 0.12 } ifelse
      t0 0.2 sub t0 0.2 add fine { 12 } { 0 } ifelse mottle
    fine {                                                 % darker brush strokes from the base
      rng 5 8 R.int {
        /f rng 0.95 R.sym def /v0 rng 0.15 0.4 R.range def /v1 rng 0.7 1.0 R.range def
        /x0 f v0 half mul 0.8 mul bend v0 dup mul mul add def
        /x1 f v1 half mul 0.9 mul bend v1 dup mul mul add def
        x0 v0  x1 x0 sub 0.3 mul x0 add  v0 v1 0.35 lerp  x1 0.95 mul  v0 v1 0.7 lerp  x1 v1
          rng 0.03 0.07 R.range 0.005 t0 0.25 sub tone rng 0.12 0.25 R.range true streak3 } repeat } if
    % pooling: the outline restroked wide and soft, only its inner half shows
    outline true 1 smooth 0.08 tone 1.6 u mul isghost { 0.15 } { 0.3 } ifelse true null istroke
    % white streaks lifted out, fanning from the base
    /ns o /streaks { pointed { rng 3 5 R.int } { rng 9 13 R.int } ifelse } optp def
    1 1 ns { /k exch def
      /f k 0.5 sub ns div 2 mul 1 sub rng 0.05 R.sym add def
      /len pointed { rng 0.4 0.85 R.range } { rng 0.35 0.8 R.range } ifelse 1 0.35 f mul f mul sub mul def
      pointed k ns 1 add 2 idiv eq and { /f 0 def /len rng 0.8 0.92 R.range def } if
      /x1 f len half mul 0.85 mul bend len dup mul mul add def
      /mx f len 0.5 mul half mul 0.6 mul rng 0.02 R.sym add bend len dup mul mul 0.3 mul add def
      f 0.03 mul 0  mx 0.5 mul len 0.3 mul  mx len 0.6 mul  x1 len
        pointed { 0.6 } { 1 } ifelse rng 0.022 0.045 R.range mul 0.002 white rng 0.55 0.9 R.range false streak3 } for
    fine {                                                 % a few fine dark veins
      rng 4 7 R.int {
        /f rng 0.85 R.sym def /v0 rng 0.2 0.35 R.range def /v1 rng 0.75 0.95 R.range def
        /x0 f v0 half mul 0.7 mul bend v0 dup mul mul add def
        /x1 f v1 half mul 0.9 mul bend v1 dup mul mul add def
        x0 v0  x1 x0 sub 0.2 mul x0 add  v0 v1 0.4 lerp  x1 0.97 mul  v0 v1 0.75 lerp  x1 v1 bezier3 5 0 1 sample false 1 smooth
        0.1 tone 0.15 rng 0.18 0.32 R.range true null istroke } repeat } if
  iunclip end } bind def

% ---------------------------------------------------------------- flowers
% the white star-shaped heart, stamens and a copper eye; r = radius scale
/heart { 6 dict begin /r exch def /np exch def /rng exch def   % rng np r ->
  1 1 2 np mul { /k exch def
    ipush k 0.5 sub 360 mul 2 np mul div rng 8 R.sym add rotate
    0 0 0.01 0.1 r mul -0.01 0.2 r mul 0 rng 0.24 0.36 R.range r mul 0.06 r mul 0.004 r mul white 0.85 false streak3
    ipop } for
  0 0 0.13 r mul circle white 0.9 false ifill
  isghost not { 14 { /a rng 0 360 R.range def /d rng 0.05 0.12 R.range r mul def
      0 0 moveto d a cos mul d a sin mul lineto 0.1 tone 0.2 0.7 strokea
      d a cos mul d a sin mul 0.008 r mul circle 0.05 tone 0.9 false ifill } repeat } if
  0 0 0.042 r mul circle -0.15 accent fillc
  0 0 0.022 r mul circle 0.3 accent fillc end } bind def

% Five broad petals seen from the front; s = petal length (cm), center at the origin
/flower { 8 dict begin /o exch def /s exch def /rng exch def   % rng s o ->
  ipush s dup scale rng 0 72 R.range rotate
  /np o /petals 5 opt def
  /t0 o /tone { rng 0.25 R.chance { rng 0.2 0.28 R.range } { rng 0.3 0.46 R.range } ifelse } optp def
  0 1 np 1 sub { /k exch def
    ipush k 360 mul np div rng 6 R.sym add rotate rng 0.9 1.06 R.range dup scale 0 0.04 translate
    rng 1 dict dup /tone t0 rng 0.04 R.sym add put petal ipop } for
  rng np 1 heart ipop end } bind def

% insertion sort in place, ascending by key(x)
/isort { 6 dict begin /_kf exch def /_ar exch def           % array key -> array
  1 1 _ar length 1 sub { /_i exch def /_x _ar _i get def /_kx _x _kf def /_j _i 1 sub def
    { _j 0 lt { exit } if _ar _j get _kf _kx le { exit } if _ar _j 1 add _ar _j get put /_j _j 1 sub def } loop
    _ar _j 1 add _x put } for _ar end } bind def

% A star lily seen at a tilt: six pointed, recurved petals in a star squashed
% along y, so the petals behind are short and darker and the ones in front long
% and pale; stamens stand out of the throat. Center at the origin, faces +y.
/lily { 12 dict begin /o exch def /s exch def /rng exch def   % rng s o ->
  ipush s dup scale
  /tilt o /tilt { rng 0.45 0.62 R.range } optp def
  /spin rng 0 60 R.range def
  /t0 o /tone { rng 0.30 0.38 R.range } optp def
  [ 0 1 5 { 60 mul spin add rng 8 R.sym add } for ] { sin neg } isort {   % back petals first
    /a exch def /back a sin def
    ipush 1 tilt scale a 90 sub rotate rng 0.88 1.05 R.range dup scale
    rng 6 dict dup /shape /pointed put dup /w rng 0.11 0.14 R.range put
      dup /tone t0 0.1 back mul -0.8 mul add rng 0.03 R.sym add put
      dup /bend rng 0.5 R.chance { 1 } { -1 } ifelse rng 0.04 0.14 R.range mul put
      dup /heart false put dup /streaks rng 3 4 R.int put
    petal ipop } forall
  1 1 4 { /k exch def rng 0 0 0.05 0.05 k mul add dup tilt mul 0.2 9 blob true 1 smooth white 0.22 false ifill } for
  isghost not {                                            % stamens: curved filaments, dark anthers, copper pollen
    1 1 6 { /k exch def
      /a k 3.5 sub 16 mul rng 6 R.sym add def /L rng 0.3 0.48 R.range def
      /ex L a sin mul def /ey L a cos mul def
      0 0 ex 0.2 mul ey 0.5 mul ex 0.8 mul ey 0.85 mul ex ey bezier3 6 0 1 sample false 1 smooth 0.12 tone 0.25 0.85 strokea
      ipush ex ey translate a neg rng 30 R.sym add rotate
      rng 0 0 0.022 0.04 0.1 6 blob true 1 smooth 0.05 tone fillc ipop
      rng 0.5 R.chance { ex rng 0.03 R.sym add ey rng 0.02 0.05 R.range add 0.008 circle 0 accent fillc } if } for } if
  0 0 0.035 circle -0.2 accent fillc
  ipop end } bind def

% A small flower with round petals, seen from the front: violets, forget-me-nots. r = radius
/blossom { 10 dict begin /o exch def /r exch def /rng exch def   % rng r o ->
  ipush r dup scale rng 0 72 R.range rotate
  /t0 o /tone { rng 0.30 0.45 R.range } optp def
  0 1 4 { /k exch def ipush k 72 mul rng 8 R.sym add rotate rng 0.9 1.08 R.range dup scale
    /hw rng 0.36 0.44 R.range roundhalf def
    /outline { 0 exch } 18 /hw load dup null blade def
    outline true 1 smooth t0 rng 0.05 R.sym add tone fillc
    outline true 1 smooth iclip
      rng rng 0.2 R.sym rng 0.5 0.9 R.range 0.35 0.3 0.3 8 blob true 1 smooth t0 0.2 sub tone 0.3 true ifill
      0 0 0.02 0.2 -0.02 0.4 rng 0.05 R.sym 0.55 0.12 0.01 white 0.7 false streak3
      outline true 1 smooth 0.08 tone 1.2 lod mul 0.25 true null istroke
    iunclip ipop } for
  0 0 0.22 circle white 0.85 false ifill
  0 0 0.09 circle o /eye { 0.08 tone } optp fillc
  ipop end } bind def

% A floret a few millimeters across: five petals, round (forget-me-not) or
% pointed (star), one fill, a dark eye. Cheap: used by the hundred. r = radius
/floret { 14 dict begin /o exch def /r exch def /rng exch def   % rng r o ->
  /star o /star { rng 0.5 R.chance } optp def
  r lod mul 0.07 lt {                                      % tiny: a 10-point star polygon
    /ph rng 0 360 R.range def
    [ 0 1 9 { /k exch def /a ph k 36 mul add def /d k 2 mod 0 eq { r } { r star { 0.32 } { 0.62 } ifelse mul } ifelse def
        [ d a cos mul d a sin mul ] } for ] true poly
    o /tone { rng 0.22 0.42 R.range } optp tone fillc
    /e 0.2 r mul def
    [ [e 0] [0 e] [e neg 0] [0 e neg] ] true poly o /eye { 0.05 tone } optp fillc
  } {
    /ph rng 0 360 R.range def
    0 1 4 { /k exch def /a ph k 72 mul add rng 8.594 R.sym add def
      /c a cos def /sn a sin def /L r rng 0.85 1.1 R.range mul def /w star { 0.26 } { 0.42 } ifelse def
      star { [ [0 0] [0.45 L mul w L mul 0.6 mul] [L 0] [0.45 L mul w L mul 0.6 mul neg] ] }
           { [ [0 0] [0.3 L mul w L mul] [0.85 L mul w L mul 0.8 mul] [L 0] [0.85 L mul w L mul 0.8 mul neg] [0.3 L mul w L mul neg] ] } ifelse
      [ exch { P /py exch def /px exch def [ px c mul py sn mul sub px sn mul py c mul add ] } forall ]
      true star { 0.5 } { 1 } ifelse smooth } for
    o /tone { rng 0.22 0.42 R.range } optp tone fillc
    r 0.05 gt isghost not and { 0 0 0.35 r mul circle white 0.75 false ifill } if
    0 0 0.16 r mul circle o /eye { 0.05 tone } optp fillc
  } ifelse end } bind def

% a closed bud: teardrop, three sepals. Base at the origin, +y; s = length
/budhalf { 0.6 pw 180 mul sin 0.8 pw 0.3 mul } bind def
/sepalhalf { 0.6 pw 180 mul sin } bind def
/bud { 10 dict begin /o exch def /s exch def /rng exch def   % rng s o ->
  ipush s dup scale
  /bend rng 0.1 R.sym def
  /outline { dup dup mul bend mul exch } 18 /budhalf load dup null blade def
  /t0 o /tone { rng 0.3 0.42 R.range } optp def
  outline true 1 smooth t0 tone fillc
  outline true 1 smooth iclip
    rng -0.3 0 0.3 1 5 0.1 t0 0.2 sub t0 0.2 add 0 mottle
    -0.08 0.05 -0.1 0.35 -0.05 0.65 bend 0.8 mul 0.95 0.06 0.005 white 0.7 false streak3
    outline true 1 smooth 0.06 tone 1.4 lod mul 0.3 true null istroke
  iunclip
  -1 1 1 { /k exch def /a k 24 mul rng 6 R.sym add def
    ipush k 0.05 mul -0.02 translate a rotate 0.06 k 0 eq { 0.22 } { 0.32 } ifelse scale
    { dup dup mul k neg 0.4 mul mul exch } 8 /sepalhalf load dup null blade true 1 smooth ipop } for
  0.14 tone 0.9 false ifill
  ipop end } bind def

% a bellflower hanging from the origin (it hangs along -y); s = length
/calyxhalf { 0.7 pw 180 mul sin } bind def
/bell { 12 dict begin /o exch def /s exch def /rng exch def   % rng s o ->
  ipush s dup scale rng 8 R.sym rotate
  /t0 o /tone { rng 0.3 0.4 R.range } optp def
  /side { /sg exch def [ 0 1 10 { 10 div /v exch def [ sg 0.12 0.22 v 1.4 pw mul add 0.08 v 6 pw mul add mul -0.02 0.82 v mul sub ] } for ] } def
  /Rs 1 side def /Ls -1 side def
  /pts [ Rs aload pop                                      % lobes along the rim, pointed tips
    [ 0.44 rng 0.03 R.sym add -0.98 rng 0.03 R.sym add ]
    [ 0.27 -0.86 rng 0.02 R.sym add ] [ 0.12 rng 0.03 R.sym add -1.0 rng 0.03 R.sym add ]
    [ -0.02 -0.9 rng 0.02 R.sym add ] [ -0.16 rng 0.03 R.sym add -1.0 rng 0.03 R.sym add ]
    [ -0.29 -0.86 rng 0.02 R.sym add ] [ -0.44 rng 0.03 R.sym add -0.98 rng 0.03 R.sym add ]
    Ls length 1 sub -1 0 { Ls exch get } for ] def
  pts true 0.7 smooth t0 tone fillc
  pts true 0.7 smooth iclip
    rng -0.5 -1.0 0.5 0 10 0.12 t0 0.2 sub t0 0.2 add 10 mottle
    -2 1 2 { /k exch def /x k 0.1 mul def
      x 0.3 mul -0.05 x 0.8 mul -0.35 x 1.3 mul -0.65 x 1.9 mul rng 0.03 R.sym add -0.92 0.02 0.012
      k 2 mod 0 eq { white 0.55 false } { 0.08 tone 0.3 true } ifelse streak3 } for
    pts true 0.7 smooth 0.06 tone 1.5 lod mul 0.3 true null istroke
  iunclip
  pts true 0.7 smooth 0.08 tone 0.18 0.35 strokea
  -1 1 1 { /k exch def ipush 0 0.02 translate 180 k 40 mul add rng 8 R.sym add rotate 0.08 0.26 scale
    { 0 exch } 8 /calyxhalf load dup null blade true 1 smooth ipop } for
  0.1 tone fillc
  0 0.02 0.06 circle 0.08 tone fillc
  ipop end } bind def

% ---------------------------------------------------------------- foliage
% A leaf pointing +y, length 1, with a bent midrib, a darker half (the leaf
% folds along its rib) and veins lifted out in white. With depth > 0 it is
% lobed like acanthus: a narrow body plus pointed lobes leaning toward the tip,
% filled as one shape; with depth 0 it is entire and finely toothed.
% Options: /w (half-width of the envelope), /lobes, /depth (0..1), /bend, /tone.
/leaf { 60 dict begin /o exch def /rng exch def             % rng o ->
  /W o /w { rng 0.20 0.27 R.range } optp def
  /bend o /bend { rng 0.25 R.sym } optp def
  /lobes o /lobes { rng 3 5 R.int } optp def
  /depth o /depth { rng 0.3 0.7 R.range } optp def
  /t0 o /tone { rng 0.26 0.38 R.range } optp def
  /u lod def /fine u 0.6 gt isghost not and def
  /spine { dup dup mul bend mul exch dup 0.3 bend mul mul 3 -1 roll exch sub exch } def
  /tangent { dup 0.01 sub 0 max spine 3 -1 roll 0.01 add 1 min spine 3 -1 roll sub 3 1 roll exch sub exch norm } def
  /envelope { dup 0.55 pw exch 1 exch sub 0.95 pw mul W 2.3 mul mul } def
  /teeth { 9 mul 1 fmod 2 mul 1 sub abs 1 exch sub 0.006 mul } def
  /bodyw depth 0 gt { 1 0.75 depth mul sub } { 1 } ifelse def
  /hb { envelope bodyw mul } def
  /outline /spine load u 0.6 gt { 36 } { 24 } ifelse /hb load dup
    { pop 3 mul teeth depth 0 gt { 0 } { 1 } ifelse mul } blade def
  /shapes 12 array def shapes 0 outline put /nsh 1 def
  /veins 12 array def /nv 0 def
  % a lobe: its axis ls(t), its half-width, toothed past its base
  /ls { dup L mul exch dup mul lb L mul mul
    2 copy dy mul neg exch dx mul add x0 add 3 1 roll dx mul exch dy mul add y0 add } def
  /lw { 0.62 pw 180 mul sin 0.75 pw L mul rng 0.26 0.3 R.range mul } def
  /ledge { pop dup 0.2 gt { 1.4 mul k add teeth L mul 4 mul } { pop 0 } ifelse } def
  depth 0 gt {
    [-1 1] { /side exch def
      1 1 lobes { /k exch def
        /v k side 0 gt { 0.25 } { 0.75 } ifelse sub lobes div 0.72 mul 0.1 add def
        v spine /y0 exch def /x0 exch def
        v tangent /ty exch def /tx exch def
        /reach v 0.08 add 0.95 min envelope rng 0.95 1.15 R.range mul def
        /ang rng 38 58 R.range def
        /c ang cos def /sn ang sin side mul def          % the tangent turned outward by ang
        /dx tx c mul ty sn mul sub def /dy tx sn mul ty c mul add def
        /L reach ang sin div 0.95 mul def
        /lb rng 0.25 R.sym side 0.15 mul sub def
        shapes nsh /ls load 11 /lw load dup /ledge load blade put /nsh nsh 1 add def
        veins nv [ x0 y0 0.45 ls 0.92 ls ] put /nv nv 1 add def } for } forall } if
  /trace { 0 1 nsh 1 sub { shapes exch get true 0.8 smooth } for } def
  trace t0 tone fillc
  trace iclip
    /sd rng 0.5 R.chance { 1 } { -1 } ifelse def          % the darker half
    [ 0 1 30 { 30 div spine 2 array astore } for [ sd 2 mul 1 ] [ sd 2 mul 0 ] ] true poly
    0.12 tone 0.28 true ifill
    rng W -2.5 mul 0 W 2.5 mul 1 fine { 13 } { 6 } ifelse 0.11 t0 0.2 sub t0 0.22 add fine { 12 } { 0 } ifelse mottle
    trace 0.06 tone 1.3 u mul 0.22 true null istroke
    /spine load 10 0.03 0.003 white 0.78 false streak       % midrib and veins in white
    0 1 nv 1 sub { veins exch get aload pop /ey exch def /ex exch def /my exch def /mx exch def /y0 exch def /x0 exch def
      x0 y0 mx my ex mx sub 0.5 mul mx add ey my sub 0.5 mul my add ex ey 0.017 0.002 white rng 0.5 0.75 R.range false streak3 } for
    depth 0 eq nv 0 eq or {
      1 1 9 { /k exch def /v k 0.3 sub 10 div 0.9 mul def /sg k 2 mod 0 eq { 1 } { -1 } ifelse def
        v spine /y0 exch def /x0 exch def v tangent /ty exch def /tx exch def
        /nx ty neg sg mul def /ny tx sg mul def /L v hb rng 0.75 0.95 R.range mul def
        x0 y0  x0 nx L mul 0.4 mul add  y0 ny L mul 0.4 mul add
        x0 nx L mul 0.75 mul add tx L mul 0.3 mul add  y0 ny L mul 0.75 mul add ty L mul 0.3 mul add
        x0 nx L mul 0.95 mul add tx L mul 0.6 mul add  y0 ny L mul 0.95 mul add ty L mul 0.6 mul add
        0.014 0.002 white rng 0.45 0.7 R.range false streak3 } for } if
  iunclip
  depth 0 eq { outline true 0.8 smooth 0.05 tone 0.18 isghost { 0.15 } { 0.4 } ifelse strokea } if
  end } bind def

% A small entire leaf, cheap: for stem nodes and sprays. +y, length 1
/leaflet { 12 dict begin /o exch def /rng exch def          % rng o ->
  /W o /w { rng 0.16 0.24 R.range } optp def
  /bend o /bend { rng 0.2 R.sym } optp def
  /t0 o /tone { rng 0.2 0.34 R.range } optp def
  /spine { dup dup mul bend mul exch } def
  /half { dup 0.5 pw exch 1 exch sub 0.9 pw mul W 2.2 mul mul } def
  /outline /spine load 18 /half load dup null blade def /c BLADEC def /nr BLADEN def
  outline true 1 smooth t0 tone fillc
  lod 0.25 gt isghost not and {
    outline true 1 smooth iclip
      /sd rng 0.5 R.chance { 1 } { -1 } ifelse def
      [ c aload pop c length 1 sub -1 0 { /i exch def
          [ c i get 0 get nr i get 0 get sd mul add c i get 1 get nr i get 1 get sd mul add ] } for ] true poly
      0.08 tone 0.3 true ifill
      /spine load 10 0.03 0.003 white 0.65 false streak
    iunclip } if end } bind def

% ---------------------------------------------------------------- stems and sprays
% a tapered stem along points, full widths in cm at the base and the tip;
% a stroke when it is thinner than 0.7 bp on the page
/lerpw { 3 -1 roll lerp } bind def                         % t w0 w1 -> lerp(w0, w1, t)
/stem { 6 dict begin /op exch def /c exch def /w1 exch def /w0 exch def /pts exch def   % pts w0 w1 c op ; c null: tone 0.07
  c null eq { /c 0.07 tone def } if
  /wbp w0 w1 add 2 div unit mul CM mul def
  wbp 0.7 lt { pts false 1 smooth c wbp op false null istroke }
             { pts [ w0 w1 /lerpw cvx ] cvx ribbon true 1 smooth c op false ifill } ifelse end } bind def

% The path of a branch from a stem point (sx,sy) whose stem runs along (tx,ty)
% to a motif at (bx,by) whose axis is (ax,ay): it leaves along the stem (or
% against it, if the target lies behind), turned 28..48 degrees toward the
% target, and arrives along the motif's axis. Returns sampled points.
/branchpath { 16 dict begin                                % rng sx sy tx ty bx by ax ay -> pts
  /ay exch def /ax exch def /by exch def /bx exch def /ty exch def /tx exch def /sy exch def /sx exch def /rng exch def
  /dx bx sx sub def /dy by sy sub def /d dx dx mul dy dy mul add sqrt def
  tx dx mul ty dy mul add -0.3 d mul lt { /tx tx neg def /ty ty neg def } if
  /turn tx dy mul ty dx mul sub 0 gt { 1 } { -1 } ifelse rng 28 48 R.range mul def
  /ox tx turn cos mul ty turn sin mul sub def /oy tx turn sin mul ty turn cos mul add def
  sx sy  sx ox d mul 0.45 mul add sy oy d mul 0.45 mul add  bx ax d mul 0.4 mul sub by ay d mul 0.4 mul sub  bx by bezier3
  d 0.15 div floor cvi 6 max 0 1 sample end } bind def

% integrate a path from a heading: start (x,y), heading(s) in degrees at arc length s
/walk { 10 dict begin /_N exch def /_L exch def /_h exch def /_y exch def /_x exch def   % x y heading L n -> pts
  /_ds _L _N div def
  [ [_x _y] 1 1 _N { 0.5 sub _ds mul _h /_a exch def /_x _x _ds _a cos mul add def /_y _y _ds _a sin mul add def [_x _y] } for ] end } bind def

% A forget-me-not cyme: a stem of length L that curls at its end like a
% scorpion's tail, florets crowding along it and shrinking into buds; often a
% second, shorter curl forks off. Starts at the origin heading +y.
/curl { 20 dict begin                                      % rng x y h0 L side t0 wbase -> pts
  /wbase exch def /t0 exch def /side exch def /L exch def /h0 exch def /y exch def /x exch def /rng exch def
  /turn rng 170 270 R.range def
  /N 36 def
  /pts x y { L div 2.3 pw side turn mul mul h0 add } L N walk def
  pts wbase 0.006 0.1 tone 1 stem
  /nr pts normals def
  /n rng 11 17 R.int def
  1 1 n { /k exch def
    /f k n div 0.75 pw 0.82 mul 0.18 add def
    /j f N mul 1.5 add floor cvi 37 min 2 max 1 sub def
    /sg k 2 mod 0 eq { 1 } { -1 } ifelse def
    pts j get P /py exch def /px exch def
    /stalk 0.1 0.02 f lerp rng 0.7 1.2 R.range mul def
    /qx px nr j get 0 get sg mul stalk mul add def /qy py nr j get 1 get sg mul stalk mul add def
    stalk 0.03 gt { px py moveto qx qy lineto 0.12 tone 0.25 0.9 strokea } if
    /r 0.115 0.03 f lerp rng 0.85 1.15 R.range mul def
    ipush qx qy translate
    f 0.8 gt { 0 0 r 0.6 mul circle t0 0.06 sub tone fillc }
             { rng r 2 dict dup /star false put dup /tone t0 rng 0.08 R.sym add put floret } ifelse
    ipop } for
  pts end } bind def
/cyme { 10 dict begin /o exch def /L exch def /rng exch def   % rng L o ->
  /side o /side { rng 0.5 R.chance { 1 } { -1 } ifelse } optp def
  /t0 rng 0.22 0.36 R.range def
  /pts rng 0 0 90 rng 10 R.sym add L side t0 0.026 curl def
  /fk o /fork null opt def
  fk false ne { rng fk null eq { 0.6 } { 1 } ifelse R.chance } { false } ifelse {
    /i pts length rng 0.25 0.4 R.range mul floor cvi def
    /a pts i get def /b pts i 1 sub get def
    /h a 0 get b 0 get sub a 1 get b 1 get sub deg def
    rng b P h side rng 30 50 R.range mul sub L rng 0.45 0.65 R.range mul side neg t0 0.04 add 0.018 curl pop } if
  end } bind def

% A wiry branching sprig (baby's breath): forks two or three ways `depth`
% times, small leaves at the lower forks, florets and buds at the tips.
/sprigbranch { 16 dict begin /w exch def /d exch def /len exch def /a exch def /y exch def /x exch def   % x y a len d w ->
  /bend rng 20 R.sym def
  /pts x y { len div bend mul a add } len 6 walk def
  pts w w 0.7 mul 0.1 tone 1 stem
  /ex pts dup length 1 sub get 0 get def /ey pts dup length 1 sub get 1 get def
  /ea a bend add def
  d 0 eq {
    ipush ex ey translate
    rng 0.7 R.chance { rng rng 0.045 0.075 R.range 1 dict dup /tone t0 rng 0.08 R.sym add put floret }
                     { 0 0 rng 0.018 0.028 R.range circle t0 0.05 sub tone fillc } ifelse
    ipop
  } {
    d depth 1 sub ge { rng 0.7 R.chance } { false } ifelse {
      /sg rng 0.5 R.chance { 1 } { -1 } ifelse def
      ipush ex ey translate ea 90 sub sg rng 40 70 R.range mul add rotate len rng 0.5 0.8 R.range mul dup scale
      rng 1 dict dup /w 0.14 put leaflet ipop } if
    /kids rng 0.25 R.chance { 3 } { 2 } ifelse def
    1 1 kids { /k exch def
      /da kids 2 eq { k 1 eq { -1 } { 1 } ifelse rng 16 34 R.range mul } { k 2 sub rng 22 36 R.range mul } ifelse def
      ex ey ea da add len rng 0.58 0.74 R.range mul d 1 sub w 0.72 mul sprigbranch } for
  } ifelse end } bind def
/sprig { 6 dict begin /o exch def /L exch def /rng exch def   % rng L o ->
  /depth o /depth 4 opt def
  /t0 rng 0.22 0.4 R.range def
  0 0 90 rng 8 R.sym add L 0.36 mul depth 0.024 sprigbranch end } bind def

% Queen Anne's lace: rays fanning upward, each ending in a small umbel of
% starry florets; bracts at the base. RR = reach (cm); base at the origin.
/umbel { 16 dict begin /o exch def /RR exch def /rng exch def   % rng R o ->
  /nr rng 9 13 R.int def
  1 1 nr { /k exch def
    /a 90 k nr 1 add 2 div sub 110 nr div mul add rng 4 R.sym add def
    /L RR rng 0.78 1.0 R.range mul 1 0.15 a 90 sub abs mul 55 div sub mul def
    /ex L a cos mul def /ey L a sin mul def
    0 0 ex 0.15 mul ey 0.5 mul ex 0.6 mul ey 0.95 mul ex ey bezier3 6 0 1 sample false 1 smooth 0.12 tone 0.25 0.9 strokea
    /ns rng 5 8 R.int def
    1 1 ns { /j exch def
      /b a j ns 1 add 2 div sub 16 mul add rng 5 R.sym add def
      /l RR rng 0.12 0.2 R.range mul def
      /fx ex l b cos mul add def /fy ey l b sin mul add def
      ex ey moveto fx fy lineto 0.14 tone 0.18 0.85 strokea
      ipush fx fy translate rng RR rng 0.035 0.05 R.range mul 2 dict dup /star true put dup /tone rng 0.25 0.42 R.range put floret ipop } for } for
  -1 1 1 { /k exch def ipush k 40 mul rng 10 R.sym add 180 add rotate RR rng 0.15 0.22 R.range mul dup scale
    rng 2 dict dup /w 0.06 put dup /bend k 0.2 mul put leaflet ipop } for
  end } bind def

% A flower gone to seed, a dandelion clock: hairline rays from a small dark
% head, each ending in a tuft, a gap where seeds have gone, and a few seeds
% drifting away up and to one side. Center at the origin; r = radius.
/tuft { 5 dict begin /l exch def /a exch def /y exch def /x exch def   % x y a l -> five hairs
  -2 1 2 { 18.335 mul a add /b exch def x y moveto x l b cos mul add y l b sin mul add lineto } for end } bind def
/acheneax { -0.12 r mul mul 0 exch } bind def              % v -> 0, -0.12 r v
/achenew { 180 mul sin 0.025 r mul mul } bind def
/seedhead { 24 dict begin /o exch def /r exch def /rng exch def   % rng r o ->
  /fine lod r mul 0.2 gt isghost not and def
  /n fine { rng 26 34 R.int } { 16 } ifelse def
  /gone rng 0 360 R.range def
  1 1 n { /k exch def
    /a k rng 0.3 R.sym add 360 mul n div def
    a gone sub 180 add 360 fmod 180 sub abs 28.65 lt { rng 0.7 R.chance } { false } ifelse not {
      /L r rng 0.72 0.86 R.range mul def
      /c a cos def /s a sin def
      0.1 r mul c mul 0.1 r mul s mul moveto L c mul L s mul lineto
      fine { L c mul L s mul a r rng 0.14 0.2 R.range mul tuft } if } if } for
  0.16 tone 0.22 0.85 strokea
  0 0 0.13 r mul circle 0.12 tone fillc
  fine { 10 { rng 0.08 r mul R.sym rng 0.08 r mul R.sym 0.03 r mul rng 0 180 R.range speck } repeat 0.04 tone 0.8 false ifill } if
  /side o /side { rng 0.5 R.chance { 1 } { -1 } ifelse } optp def
  o /drift { rng 2 4 R.int } optp {                        % drifting seeds: an achene on a beak, the tuft above it
    /d r rng 1.3 2.4 R.range mul def
    /a 90 side rng 15 60 R.range mul sub def
    /x d a cos mul def /y d a sin mul def
    /tilt 90 rng 35 R.sym add def
    /l r 0.32 mul def
    /tx x l tilt cos mul add def /ty y l tilt sin mul add def
    x y moveto tx ty lineto
    tx ty tilt r 0.17 mul tuft
    0.18 tone 0.2 0.8 strokea
    ipush x y translate tilt 90 sub rotate
    /acheneax load 6 /achenew load dup null blade true 1 smooth 0.1 tone fillc ipop } repeat
  end } bind def

% a tapered logarithmic spiral, s = size; starts at the origin, outer end
/tendril { 8 dict begin /s exch def /rng exch def          % rng s ->
  /turns rng 1.6 2.3 R.range def
  [ 0 1 50 { 50 div /t exch def /a t turns mul 360 mul def /r s 1 0.92 t mul sub 1.6 pw mul def [ r a cos mul s sub r a sin mul ] } for ]
  0.022 0.004 0.12 tone 1 stem end } bind def

% ---------------------------------------------------------------- accents (copper hairlines)
% a four-point star with a hairline cross; r = radius
/sparkle { 6 dict begin /o exch def /r exch def /rng exch def   % rng r o ->
  /c o /color { 0 accent } optp def /k 0.12 def
  [ [0 r] [k r mul k r mul] [r 0.75 mul 0] [k r mul k r mul neg] [0 r neg] [k r mul neg k r mul neg] [r -0.75 mul 0] [k r mul neg k r mul] ] true poly c fillc
  o /rays true opt {
    0 r 1.15 mul moveto 0 r 1.7 mul lineto 0 r -1.15 mul moveto 0 r -1.7 mul lineto c 0.2 0.8 strokea
    0 r 1.9 mul r 0.07 mul circle 0 r -1.9 mul r 0.07 mul circle c 0.8 false ifill } if end } bind def
% a tiny hairline quatrefoil with a dot; r = radius
/rosette { 6 dict begin /o exch def /r exch def /rng exch def   % rng r o ->
  /c o /color { 0 accent } optp def
  0 1 3 { 90 mul 45 add /a exch def r 0.5 mul a cos mul r 0.5 mul a sin mul r 0.42 mul circle } for
  c 0.22 0.85 strokea
  0 0 r 0.14 mul circle c fillc
  0 r 1.05 mul moveto 0 r 1.5 mul lineto 0 r -1.05 mul moveto 0 r -1.5 mul lineto c 0.2 0.7 strokea end } bind def
% the header fleuron: a printer's ivy leaf (hedera) in copper, tip down-left,
% its stem curling once and running out to the right, where the head rule
% continues. Origin at the leaf's notch; leaves the stem's end in page cm.
/hedera { 8 dict begin /o exch def /s exch def /rng exch def   % rng s o -> x y
  /c o /color { 0 accent } optp def
  ipush s dup scale
  /pts [ 0 1 47 { 48 div 360 mul /t exch def
      /x 16 t sin dup dup mul mul mul def
      /y 13 t cos mul 5 2 t mul cos mul sub 2 3 t mul cos mul sub 4 t mul cos sub def
      [ x 17 div y 5 sub 17 div ] } for ] def
  ipush -38 rotate
  pts true 1 smooth c fillc
  0 -0.05 moveto 0.02 -0.4 -0.02 -0.8 0 -1.12 curveto     % veins scratched out of the copper
  0 -0.35 moveto 0.15 -0.38 0.3 -0.32 0.42 -0.22 curveto
  0 -0.35 moveto -0.15 -0.38 -0.3 -0.32 -0.42 -0.22 curveto
  paper 0.35 strokec
  ipop
  [ [0 0] [0.12 0.28] [0.38 0.42] [0.6 0.3] [0.52 0.1] [0.36 0.2] [0.48 0.36] [0.85 0.36] [1.4 0.3] [2.0 0.28] ] 0.05 0.012 c 1 stem
  -0.25 0.42 0.04 circle 0.95 0.6 0.035 circle 0.7 -0.05 0.03 circle c 0.85 false ifill
  2.0 0.28 topage
  ipop end } bind def

% ---------------------------------------------------------------- visitors
/ellipse { 6 dict begin /n exch def /ry exch def /rx exch def /cy exch def /cx exch def   % cx cy rx ry n -> pts
  [ 0 1 n 1 sub { 360 mul n div /a exch def [ cx rx a cos mul add cy ry a sin mul add ] } for ] end } bind def
% one wing (or any flat shape) painted like a petal: wash, blotches, a dark
% pooled border, white veins fanning from the root (rx, ry), pale spots at the rim
/wing { 14 dict begin /fine exch def /spots exch def /ry exch def /rx exch def /t0 exch def /pts exch def /rng exch def
  pts true 1 smooth t0 tone fillc
  pts true 1 smooth iclip
    rng -1.2 -1.2 1.2 1.2 fine { 9 } { 4 } ifelse 0.14 t0 0.2 sub t0 0.2 add fine { 8 } { 0 } ifelse mottle
    pts true 1 smooth 0.05 tone 0.26 lod mul CM mul isghost { 0.25 } { 0.55 } ifelse true null istroke
    0 1 pts length 1 sub { /i exch def pts i get P /py exch def /px exch def
      /f rng 0.7 0.88 R.range def
      /ex px rx sub f mul rx add def /ey py ry sub f mul ry add def
      rx ry rx ex 0.3 lerp ry ey 0.4 lerp rx ex 0.7 lerp ry ey 0.75 lerp ex ey 0.035 0.004 white rng 0.35 0.6 R.range false streak3
      spots fine and i 0 gt and i pts length 1 sub lt and {
        px rx sub 0.9 mul rx add py ry sub 0.9 mul ry add rng 0.025 0.04 R.range circle white 0.8 false ifill } if } for
  iunclip end } bind def

% A butterfly seen from above, wings spread, head toward +y, the body's center
% at the origin; s = wingspan
/bodyhalf { 0.7 pw 180 mul sin 0.05 mul } bind def
/butterfly { 16 dict begin /o exch def /s exch def /rng exch def   % rng s o ->
  /open o /open 1 opt def
  ipush s 2 div dup scale                                  % one unit = half the span
  /fine lod 0.3 gt isghost not and def
  /t0 o /tone { rng 0.28 0.4 R.range } optp def
  /jit { [ exch { P exch rng 0.03 R.sym add exch rng 0.03 R.sym add 2 array astore } forall ] } def
  /FW [ [0.05 0.1] [0.3 0.45] [0.65 0.68] [0.92 0.66] [1.0 0.5] [0.88 0.25] [0.55 0.05] [0.15 -0.02] ] jit def
  /HW [ [0.06 -0.02] [0.45 -0.02] [0.72 -0.22] [0.7 -0.5] [0.5 -0.72] [0.25 -0.7] [0.08 -0.35] ] jit def
  /eye rng 0.7 R.chance def
  /side { [ exch { P exch sx mul open mul exch 2 array astore } forall ] } def
  [-1 1] { /sx exch def
    rng HW side t0 0.06 add sx 0.04 mul open mul -0.04 true fine wing
    eye fine and {                                         % an eyespot with a copper pupil
      /ex sx 0.43 mul open mul def /ey -0.42 def
      ex ey 0.11 open mul 0.11 10 ellipse true 1 smooth 0.08 tone 0.85 false ifill
      ex ey 0.07 open mul 0.07 10 ellipse true 1 smooth white 0.85 false ifill
      ex ey 0.035 open mul 0.035 8 ellipse true 1 smooth 0 accent fillc } if } forall
  [-1 1] { /sx exch def rng FW side t0 sx 0.04 mul open mul 0.04 true fine wing } forall
  { 0.62 mul -0.62 add 0 exch } 10 /bodyhalf load dup null blade true 1 smooth 0.06 tone fillc
  0 0.08 0.075 0.13 10 ellipse true 1 smooth 0.04 tone fillc
  0 0.27 0.06 circle 0.04 tone fillc
  fine {
    [-1 1] { /sx exch def /ex sx rng 0.22 0.3 R.range mul def /ey rng 0.78 0.9 R.range def
      sx 0.02 mul 0.31 moveto sx 0.05 mul 0.5 ex 0.6 mul ey 0.9 mul ex ey curveto 0.08 tone 0.35 strokec
      ex ey 0.025 circle 0.06 tone fillc } forall
    -0.015 -0.55 -0.02 -0.35 -0.02 -0.1 -0.01 0.0 0.015 0.004 white 0.45 false streak3 } if
  ipop end } bind def

% A bee from above, head toward +y, center at the origin; s = body length.
% /trail: a dotted flight path looping away behind it.
/bee { 20 dict begin /o exch def /s exch def /rng exch def   % rng s o ->
  ipush s dup scale
  /fine lod 0.25 gt isghost not and def
  o /trail true opt isghost not and {
    /RR 0.32 def /c rng 0.16 0.22 R.range def /turns rng 1.2 1.6 R.range def
    /side rng 0.5 R.chance { 1 } { -1 } ifelse def
    [ 0 1 60 { 60 div turns mul 360 mul /th exch def
        [ side RR mul th sin mul  -0.62 c th mul 57.29578 div sub RR th cos 1 sub mul 0.6 mul add ] } for ]
    false 1 smooth 0.18 tone 0.9 0.7 false [[0 2.6] 0] istroke } if
  /ab 0 -0.2 0.19 0.3 16 ellipse def                       % abdomen with dark bands, a sting
  ab true 1 smooth 0.38 tone fillc
  ab true 1 smooth iclip
    0 1 2 { 0.14 mul -0.06 exch sub /y exch def
      [ [-0.3 y 0.035 add] [0 y 0.06 add] [0.3 y 0.035 add] [0.3 y 0.035 sub] [0 y 0.01 sub] [-0.3 y 0.035 sub] ] true poly } for
    0.05 tone 0.9 false ifill
    fine { rng -0.2 -0.5 0.2 0.1 4 0.06 0.2 0.55 4 mottle } if
    ab true 1 smooth 0.05 tone 0.12 lod mul CM mul 0.4 true null istroke
    -0.1 -0.38 -0.13 -0.25 -0.12 -0.12 -0.08 0.0 0.04 0.008 white 0.55 false streak3
  iunclip
  [ [-0.025 -0.48] [0 -0.58] [0.025 -0.48] ] true poly 0.05 tone fillc
  fine { [-1 1] { /sx exch def 0 1 2 { /k exch def /y0 0.17 0.06 k mul sub def   % legs
        /ex sx rng 0.26 0.32 R.range mul def /ey y0 0.12 sub 0.08 1 k sub mul add rng 0.03 R.sym add def
        sx 0.08 mul y0 moveto sx 0.18 mul y0 0.04 add ex 0.9 mul ey 0.05 add ex ey curveto } for } forall
    0.08 tone 0.35 strokec } if
  rng 0 0.15 0.14 0.13 0.18 12 blob true 1 smooth 0.06 tone fillc   % a furry thorax and the head
  fine { rng -0.14 0.03 0.14 0.28 3 0.05 0.02 0.3 6 mottle } if
  0 0.33 0.09 0.075 10 ellipse true 1 smooth 0.04 tone fillc
  [-1 1] { /sx exch def sx 0.03 mul 0.38 moveto sx 0.07 mul 0.48 lineto sx 0.14 mul 0.53 lineto } forall
  0.06 tone 0.3 strokec
  [-1 1] { /sx exch def                                    % wings over the body: clear, veined, a little blue
    1 1 2 { /k exch def /wl [ [0.5 0.16 32] [0.36 0.12 52] ] k 1 sub get def
      ipush sx 0.07 mul 0.17 0.04 k mul sub translate sx 0 gt { wl 2 get neg } { 180 wl 2 get add } ifelse rotate
      /w wl 0 get 2 div 0 wl 0 get 2 div wl 1 get 2 div 14 ellipse def
      w true 1 smooth 0.85 tone 0.55 false ifill
      w true 1 smooth 0.15 tone 0.3 0.75 strokea
      fine { 0.02 0 moveto wl 0 get 0.3 mul 0.02 wl 0 get 0.6 mul 0.01 wl 0 get 0.85 mul 0 curveto
             wl 0 get 0.3 mul 0.01 moveto wl 0 get 0.55 mul wl 1 get 0.4 mul lineto 0.2 tone 0.2 0.6 strokea } if
      ipop } for } forall
  ipop end } bind def

% A snail crawling up along +y, its foot on the y axis and its shell on the +x
% side, origin at the middle of the foot; s = shell diameter
/snail { 24 dict begin /o exch def /s exch def /rng exch def   % rng s o ->
  ipush s dup scale
  /fine lod 0.25 gt isghost not and def
  /body [ [0.0 -0.78] [-0.01 -0.3] [0.0 0.3] [0.04 0.58] [0.12 0.7] [0.22 0.66] [0.24 0.5] [0.2 0.32] [0.17 0.0] [0.12 -0.45] [0.05 -0.7] ]
    [ exch { P exch 1 rng 0.08 R.sym add mul exch 2 array astore } forall ] def
  /tb o /tone { rng 0.5 0.6 R.range } optp def
  body true 1 smooth tb tone fillc
  body true 1 smooth iclip
    fine { rng -0.1 -0.8 0.3 0.8 5 0.1 tb 0.25 sub tb 0.15 add 10 mottle } if
    -0.05 -0.8 moveto -0.05 0.7 lineto 0.04 0.7 lineto 0.04 -0.8 lineto closepath 0.15 tone 0.35 true ifill
    body true 1 smooth 0.08 tone 0.1 lod mul CM mul 0.4 true null istroke
  iunclip
  1 1 3 { /k exch def /f [ [0.17 0.66 0.36 1.02] [0.1 0.7 0.18 1.04] [0.05 0.68 0.0 0.84] ] k 1 sub get def   % feelers
    f 0 get f 1 get moveto f 0 get 0.02 add f 1 get 0.12 add f 2 get 0.04 sub f 3 get 0.1 sub f 2 get f 3 get curveto
    0.12 tone k 3 lt { 0.45 } { 0.35 } ifelse strokec
    k 3 lt { f 2 get f 3 get 0.028 circle 0.05 tone fillc } if } for
  /cx 0.36 def /cy 0.0 def /RR 0.42 def                    % the shell: a white spiral lifted out, a dark one beside it
  /t0 rng 0.22 0.32 R.range def
  /shell rng cx cy RR RR 0.96 mul 0.03 16 blob def
  shell true 1 smooth t0 tone fillc
  shell true 1 smooth iclip
    rng cx RR sub cy RR sub cx RR add cy RR add fine { 7 } { 3 } ifelse 0.1 t0 0.18 sub t0 0.22 add fine { 10 } { 0 } ifelse mottle
    /turns rng 2.3 2.7 R.range def /ph rng 0 360 R.range def
    /sp 51 array def /dk 51 array def
    0 1 50 { /i exch def /t i 50 div def /a ph t turns mul 360 mul add def
      /r RR 0.95 mul t 1.15 pw mul def /r2 RR 0.95 mul t 0.12 sub 0 max 1.15 pw mul def
      sp i [ cx r a cos mul add cy r a sin mul add ] put dk i [ cx r2 a cos mul add cy r2 a sin mul add ] put } for
    dk false 1 smooth 0.05 tone 0.07 lod mul CM mul 0.6 true null istroke
    sp false 1 smooth white 0.05 lod mul CM mul 0.75 false null istroke
    shell true 1 smooth 0.05 tone 0.12 lod mul CM mul 0.5 true null istroke
  iunclip
  ipop end } bind def

% A small songbird perched, seen from the side, facing +x (/facing -1: -x);
% its feet at the origin, s = length from tail to beak
/tailhalf { 0.4 pw 180 mul sin 0.6 pw 0.055 mul } bind def
/bird { 24 dict begin /o exch def /s exch def /rng exch def   % rng s o ->
  ipush o /facing 1 opt s mul s scale
  /fine lod 0.3 gt isghost not and def
  /t0 o /tone { rng 0.3 0.38 R.range } optp def
  1 1 4 { /k exch def /L rng 0.42 0.5 R.range def          % the tail: long feathers fanning down and back
    ipush -0.26 0.28 translate rng -150 -140 R.range 7 k mul add 90 sub rotate
    /f { L mul 0 exch } 10 /tailhalf load dup null blade def
    f true 1 smooth 0.12 0.05 k mul add tone fillc
    f true 1 smooth 0.05 tone 0.3 0.5 strokea
    ipop } for
  /body [ [0.37 0.56] [0.3 0.665] [0.15 0.64] [-0.03 0.54] [-0.22 0.4] [-0.31 0.3] [-0.27 0.22] [-0.08 0.12] [0.12 0.12] [0.27 0.27] [0.35 0.42] ]
    [ exch { P exch rng 0.012 R.sym add exch rng 0.012 R.sym add 2 array astore } forall ] def
  body true 1 smooth t0 tone fillc
  body true 1 smooth iclip                                 % pale breast with darker specks, a darker cap
    1 1 4 { /k exch def rng 0.17 0.27 0.08 0.04 k mul add 0.06 0.03 k mul add 0.2 9 blob true 1 smooth white 0.2 false ifill } for
    rng -0.35 0.1 0.4 0.7 fine { 10 } { 4 } ifelse 0.07 t0 0.2 sub t0 0.2 add fine { 10 } { 0 } ifelse mottle
    fine { 14 { /x rng 0.08 0.3 R.range def /y rng 0.16 0.42 R.range def
        ipush x y translate rng -20 20 R.range rotate 0 0 0.012 0.022 6 ellipse true 1 smooth ipop } repeat
      0.1 tone 0.7 false ifill } if
    rng 0.24 0.66 0.15 0.08 0.1 9 blob true 1 smooth 0.08 tone 0.6 true ifill
    body true 1 smooth 0.05 tone 0.07 lod mul CM mul 0.5 true null istroke
  iunclip
  /wingpts [ [0.17 0.47] [0.04 0.52] [-0.12 0.45] [-0.28 0.33] [-0.44 0.22] [-0.35 0.23] [-0.38 0.19] [-0.26 0.21] [-0.28 0.17] [-0.12 0.23] [0.05 0.31] [0.15 0.4] ] def
  /tw t0 0.1 sub def                                       % the folded wing, white lifted along the feathers
  wingpts true 0.8 smooth tw tone fillc
  wingpts true 0.8 smooth iclip
    rng -0.45 0.15 0.2 0.6 fine { 6 } { 3 } ifelse 0.07 tw 0.15 sub tw 0.2 add 0 mottle
    1 1 5 { /k exch def /y 0.28 0.04 k mul add def
      0.12 y 0.05 add 0.0 y 0.03 add -0.15 y 0.03 sub -0.3 0.02 k mul sub y 0.1 sub 0.01 k mul sub 0.025 0.003 white rng 0.45 0.7 R.range false streak3 } for
    wingpts true 0.8 smooth 0.04 tone 0.06 lod mul CM mul 0.5 true null istroke
  iunclip
  [ [0.355 0.585] [0.47 0.545] [0.36 0.51] ] true poly 0.05 tone fillc   % beak, eye, legs
  0.36 0.548 moveto 0.45 0.546 lineto white 0.2 0.6 strokea
  0.285 0.585 0.03 circle white 0.95 false ifill
  0.29 0.585 0.018 circle 0.03 tone fillc
  0.284 0.592 0.006 circle white fillc
  [0.0 0.08] { /lx exch def lx 0.02 add 0.14 moveto lx 0 lineto lx 0.05 sub 0 moveto lx 0.05 add 0.005 lineto } forall
  0.06 tone 0.45 strokec
  ipop end } bind def

% ================================================================ the growth
% A plant, not a packing. Everything grows from one root in the bottom-left
% corner: stems sway up the margin, leaves hang at their nodes, and then a
% greedy loop (after Wong, Zongker & Salesin, "Computer-Generated Floral
% Ornament", SIGGRAPH 1998) takes the largest free disc within reach of a
% stem, chooses a motif that fits it and grows a branch to it from the nearest
% stem point. Branches become stems for later branches.

% ---------------------------------------------------------------- motifs
% r: s -> proxy radius; off: s -> distance from the disc's center back to the
% motif's origin along its axis; upright: the axis leans up; draw: rng s -> .
% spring/summer/autumn multiply the weight w as the garden ages.
/blossomsdraw { 10 dict begin /s exch def /rng exch def    % a spray of blossoms on stalks
  /n rng 2 4 R.int def
  1 1 n { /k exch def
    /a k n 1 add 2 div sub 38 mul rng 10 R.sym add def
    /d s rng 0.45 0.8 R.range mul k 1 eq { 1 } { rng 0.85 1.1 R.range } ifelse mul def
    /x d a sin mul def /y d a cos mul def
    0 0 moveto 0 d 0.4 mul x 0.6 mul y 0.7 mul x y curveto 0.1 tone 0.35 strokec
    ipush x y translate rng s rng 0.38 0.5 R.range mul NOOPT blossom ipop } for
  rng 0.6 R.chance { ipush rng 50 R.sym rotate 0.5 s mul dup scale rng 1 NOOPT bud ipop } if
  end } bind def
/buddingdraw { 10 dict begin /s exch def /rng exch def     % a spray of closed buds on stalks
  /n rng 2 4 R.int def
  1 1 n { /k exch def
    /a k n 1 add 2 div sub 34 mul rng 10 R.sym add def
    /d s rng 0.5 0.85 R.range mul def
    /x d a sin mul def /y d a cos mul def
    0 0 moveto 0 d 0.4 mul x 0.6 mul y 0.7 mul x y curveto 0.1 tone 0.35 strokec
    ipush x y translate a -0.6 mul rotate rng s rng 0.45 0.6 R.range mul NOOPT bud ipop } for end } bind def
/leafdraw { 2 dict begin /s exch def /rng exch def
  s dup scale rng 2 dict dup /w rng 0.22 0.3 R.range put dup /depth rng 0.6 R.chance { rng 0.4 0.8 R.range } { 0 } ifelse put leaf end } bind def
/bellsdraw { 2 dict begin /s exch def /rng exch def
  rng s NOOPT bell
  0 0 moveto 0.15 s mul 0.25 s mul 0.4 s mul 0.25 s mul 0.5 s mul 0.1 s mul curveto 0.1 tone 0.35 strokec
  ipush 0.5 s mul 0.1 s mul translate rng 0.75 s mul NOOPT bell ipop end } bind def
/MOTIFS [
  << /name /flower /w 3 /smin 0.75 /smax 1.3 /max 3 /hard true /layer 5 /spring 0.12 /autumn 0.45
     /r { 1.0 mul } /off { pop 0 } /draw { NOOPT flower } >>
  << /name /lily /w 2 /smin 0.8 /smax 1.25 /max 2 /hard true /layer 5 /upright 0.4 /spring 0.1 /autumn 0.4
     /r { 0.9 mul } /off { 0.15 mul } /draw { NOOPT lily } >>
  << /name /blossoms /w 3 /smin 0.55 /smax 0.85 /max 5 /layer 5 /upright 0.5 /spring 0.5 /autumn 0.5
     /r { } /off { 0.6 mul } /draw { blossomsdraw } >>
  << /name /cyme /w 3 /smin 1.0 /smax 2.4 /max 6 /layer 4 /upright 0.6 /spring 1.3 /autumn 0.7
     /r { 0.45 mul } /off { 0.5 mul } /draw { NOOPT cyme } >>
  << /name /sprig /w 2 /smin 1.2 /smax 2.8 /max 4 /layer 4 /upright 0.8 /spring 1.2
     /r { 0.42 mul } /off { 0.5 mul } /draw { NOOPT sprig } >>
  << /name /umbel /w 1.5 /smin 0.8 /smax 1.5 /max 3 /hard true /layer 4 /upright 1.0 /spring 0.8 /autumn 0.8
     /r { 0.75 mul } /off { 0.6 mul } /draw { NOOPT umbel } >>
  << /name /leaf /w 2 /smin 0.9 /smax 2.0 /max 8 /layer 3 /upright 0.2 /spring 1.3 /autumn 1.2
     /r { 0.32 mul } /off { 0.5 mul } /draw { leafdraw } >>
  << /name /bud /w 1 /smin 0.45 /smax 0.75 /max 5 /layer 5 /upright 0.5 /spring 3.5 /autumn 0.3
     /r { 0.45 mul } /off { 0.5 mul } /draw { NOOPT bud } >>
  << /name /bells /w 0.7 /smin 0.6 /smax 0.95 /max 1 /hard true /layer 5 /hang true /spring 0.5 /autumn 0.6
     /r { 0.62 mul } /off { pop 0 } /draw { bellsdraw } >>
  << /name /tendril /w 0.6 /smin 0.3 /smax 0.5 /max 4 /layer 4 /spring 2 /autumn 1.3
     /r { } /off { } /draw { 90 rotate tendril } >>
  << /name /budding /w 3 /smin 0.55 /smax 0.9 /max 6 /layer 5 /upright 0.6 /spring 1 /summer 0 /autumn 0
     /r { 0.9 mul } /off { 0.6 mul } /draw { buddingdraw } >>
  << /name /seedhead /w 2 /smin 0.45 /smax 0.75 /max 3 /hard true /layer 4 /upright 0.6 /spring 0 /summer 0 /autumn 1
     /r { 1.05 mul } /off { pop 0 } /draw { NOOPT seedhead } >>
  << /name /butterfly /w 0.8 /smin 1.1 /smax 1.5 /max 2 /hard true /layer 6 /fly true
     /r { 0.5 mul } /off { pop 0 } /draw { NOOPT butterfly } >>
  << /name /bee /w 0.8 /smin 0.7 /smax 0.85 /max 2 /hard true /layer 6 /fly true
     /r { 0.6 mul } /off { pop 0 } /draw { NOOPT bee } >>
] def
/MOTIFD MOTIFS length dict def MOTIFS { MOTIFD exch dup /name get exch put } forall
/motif { MOTIFD exch 2 copy known { get } { pop pop null } ifelse } bind def   % name -> motif dict or null

% ---------------------------------------------------------------- growth helpers
% They work on the variables of growpage (its dictionary is on top while it
% runs) and keep their own scratch names under a prefix.
% regions: rectangles [x0 y0 x1 y1], a union; shared edges count as open
/inside { /b.y exch def /b.x exch def /b.r exch def        % r x y -> bool
  b.x b.r 0 get gt b.x b.r 2 get lt and b.y b.r 1 get gt and b.y b.r 3 get lt and } bind def
/border { /bo.y exch def /bo.x exch def /bo.best -1 def    % x y -> distance to the nearest closed edge
  rects { /bo.r exch def
    bo.r bo.x bo.y inside {
      /bo.d 1e30 def
      [ [ bo.x bo.r 0 get sub  bo.r 0 get 0.05 sub  bo.y ]
        [ bo.r 2 get bo.x sub  bo.r 2 get 0.05 add  bo.y ]
        [ bo.y bo.r 1 get sub  bo.x  bo.r 1 get 0.05 sub ]
        [ bo.r 3 get bo.y sub  bo.x  bo.r 3 get 0.05 add ] ] {
        /bo.e exch def /bo.open false def
        rects { /bo.o exch def bo.o bo.r ne { bo.o bo.e 1 get bo.e 2 get inside { /bo.open true def } if } if } forall
        bo.open not bo.e 0 get bo.d lt and { /bo.d bo.e 0 get def } if } forall
      bo.d bo.best gt { /bo.best bo.d def } if } if } forall
  bo.best } bind def
% visit the grid cells within R of (x,y): proc gets the cell's index
/eachnear { /e.f exch def /e.R exch def /e.y exch def /e.x exch def
  e.x e.R sub GRID div floor cvi 0 max 1 e.x e.R add GRID div floor cvi NX 1 sub min { NY mul
    e.y e.R sub GRID div floor cvi 0 max 1 e.y e.R add GRID div floor cvi NY 1 sub min {
      1 index add LAT exch get dup null ne { e.f } { pop } ifelse } for pop } for } bind def
% a proxy disc: cells count it at k of its radius (k < 1 lets things overlap)
/disc { /d.k exch def /d.r exch def /d.y exch def /d.x exch def   % x y r k ->
  /d.kr d.k d.r mul def
  d.x d.y d.kr maxfree add {
    dup gx exch get d.x sub dup mul 1 index gy exch get d.y sub dup mul add sqrt d.kr sub
    dup 2 index free exch get lt { free 3 1 roll put } { pop pop } ifelse } eachnear } bind def
/freeat { GRID div floor cvi exch GRID div floor cvi       % x y -> free radius there, -1 outside
  dup 0 lt 1 index NX ge or 2 index 0 lt or 2 index NY ge or { pop pop -1 }
  { NY mul add LAT exch get dup null eq { pop -1 } { free exch get } ifelse } ifelse } bind def
% stem points [x y tx ty w]: a branch may start at any of them
/addstem { /a.ev exch def /a.w1 exch def /a.w0 exch def /a.p exch def /a.n a.p length def   % pts w0 w1 every ->
  0 a.ev a.n 1 sub { /a.i exch def
    a.p a.i 1 add a.n 1 sub min get P a.p a.i 1 sub 0 max get P 3 -1 roll exch sub 3 1 roll sub exch norm /a.ty exch def /a.tx exch def
    a.p a.i get P /a.y exch def /a.x exch def
    spts nspts [ a.x a.y a.tx a.ty a.w0 a.w1 a.i a.n 1 sub 1 max div lerp ] put /nspts nspts 1 add def
    a.x a.y REACH { dup gx exch get a.x sub dup mul 1 index gy exch get a.y sub dup mul add sqrt
      dup 2 index sdist exch get lt { sdist 3 1 roll put } { pop pop } ifelse } eachnear } for } bind def
/nearest { /n.y exch def /n.x exch def /n.best 1e30 def /n.bp null def   % x y -> stem point, distance
  0 1 nspts 1 sub { spts exch get dup 0 get n.x sub dup mul 1 index 1 get n.y sub dup mul add
    dup n.best lt { /n.best exch def /n.bp exch def } { pop pop } ifelse } for
  n.bp n.best sqrt } bind def
/gstem { /s.pr exch def /s.w1 exch def /s.w0 exch def /s.p exch def   % pts w0 w1 proxy -> drawn, and in the grid
  2 layer s.p s.w0 s.w1 null 1 stem
  0 2 s.p length 1 sub { s.p exch get P s.pr 1 disc } for } bind def
% draw proc at (x,y) with its +y axis at angle a (degrees from +x), in a layer
/place { 5 -1 roll layer ipush 4 1 roll 3 1 roll translate 90 sub rotate exec ipop } bind def   % layer x y a proc ->
/ptangent { /pt.i exch def /pt.p exch def                  % pts i -> unit tangent
  pt.p pt.i 1 add pt.p length 1 sub min get P pt.p pt.i 1 sub 0 max get P 3 -1 roll exch sub 3 1 roll sub exch norm } bind def
/addbloom { blooms nblooms 3 -1 roll put /nblooms nblooms 1 add def } bind def
% a branch from stem point S to a motif at (bx,by) whose axis is (ax,ay); a
% leaflet or two on a longer one
/branchto { /t.w0 exch def /t.ay exch def /t.ax exch def /t.by exch def /t.bx exch def /t.S exch def   % S bx by ax ay w0 ->
  /t.pts layout t.S 0 get t.S 1 get t.S 2 get t.S 3 get t.bx t.by t.ax t.ay branchpath def
  /t.d t.S 0 get t.S 1 get t.bx t.by dist def
  /t.w t.S 4 get 0.7 mul t.w0 min def
  t.pts t.w 0.012 t.w 0.45 mul max 0.07 gstem
  t.pts t.w 0.012 t.w 0.45 mul max 2 addstem
  t.d 1.0 gt {
    /t.nl t.d 2 gt { 2 } { 1 } ifelse def
    1 1 t.nl { /t.j exch def
      /t.i t.pts length 0.3 t.j mul t.nl div 0.25 add mul floor cvi 1 sub def
      /t.p t.pts t.i get def /t.q t.pts t.i 1 add get def
      /t.a t.q 0 get t.p 0 get sub t.q 1 get t.p 1 get sub deg t.j 2 mod 0 eq { 1 } { -1 } ifelse layout 40 60 R.range mul add def
      /t.ls layout 0.45 0.75 R.range def
      3 t.p P t.a { t.ls dup scale rng R.fork NOOPT leaflet } place
      t.p 0 get t.a cos t.ls mul 0.5 mul add t.p 1 get t.a sin t.ls mul 0.5 mul add 0.25 t.ls mul 0.7 disc } for } if } bind def
/season { age 0 lt { pop exch pop } {                 % spring summer autumn -> value for this page's age
  age 0.5 lt { pop 0.1 0.5 age smoothstep lerp } { 3 -1 roll pop 0.5 0.9 age smoothstep lerp } ifelse } ifelse } bind def
/inc { 2 copy get 1 add put } bind def                     % dict key -> ; adds one

% ---------------------------------------------------------------- the page
% g: seed, pw ph (paper), textleft textright ybot, colright (the margin's right
% edge), headrule, footy, spill (1 on the last page) and spilly (where the text
% ends), marks [[y] ...] (the headings), age (-1: summer), visitors
/GRID 0.2 def    % candidate spacing (cm)
/REACH 3.0 def   % a motif must be within this distance of a stem
/SMALLEST 0.36 def   % the branch loop stops below this free radius
/FILLMIN 0.17 def    % the filler stops below this
/growpage { 400 dict begin /g exch def
  /rng g /seed get 7919 mul 13 add R.new def
  /layout rng R.fork def                                   % decisions; primitives get their own forks
  % visitors come from their own stream, the season's additions from another
  /vis g /seed get 7919 mul 101 add R.new def
  /visiting g /visitors get
    { << /butterfly vis 0.75 R.chance /bee vis 0.6 R.chance /snail vis 0.4 R.chance /bird vis 0.22 R.chance >> }
    { 0 dict } ifelse def
  /age g /age get def
  /spring 1 0 0 season def /autumn 0 0 1 season def
  /sea g /seed get 7919 mul 211 add R.new def
  /blooms 64 array def /nblooms 0 def

  % regions: margin column, footer band, and the space under the text on the last page
  /col [ 0.3 0.45 g /colright get g /ph get 0.5 sub ] def
  /fx1 g /textleft get g /textright get g /textleft get sub layout 0.42 0.52 R.range mul add def
  /foot [ g /colright get 0.01 sub 0.4 fx1 1.75 g /footy get 0.45 sub min ] def
  /spill null def
  g /spill get 1 eq g /spilly get 0.8 sub g /ybot get 0.6 add sub 2.5 gt and {
    /spill [ g /colright get 0.01 sub g /ybot get 0.6 add g /textright get 0.2 sub g /spilly get 0.8 sub ] def } if
  /rects spill null eq { [ col foot ] } { [ col foot spill ] } ifelse def

  % the grid: one cell per GRID, on a lattice over the page so that a disc only visits nearby cells
  /NX g /pw get GRID div floor cvi 2 add def /NY g /ph get GRID div floor cvi 2 add def
  /LAT NX NY mul array def
  /CAP 0 rects { aload pop 3 -1 roll sub 3 1 roll exch sub GRID div 2 add exch GRID div 2 add mul add } forall cvi def
  /gx CAP array def /gy CAP array def /free CAP array def /sdist CAP array def /ncell 0 def
  rects { /r exch def
    r 0 get GRID div floor cvi 1 r 2 get GRID div floor cvi { /ix exch def
      r 1 get GRID div floor cvi 1 r 3 get GRID div floor cvi { /iy exch def
        LAT ix NY mul iy add get null eq {
          /x ix 0.5 add GRID mul def /y iy 0.5 add GRID mul def
          x y border /b exch def
          b 0 gt { gx ncell x put gy ncell y put free ncell b put sdist ncell 1e30 put
                   LAT ix NY mul iy add ncell put /ncell ncell 1 add def } if } if } for } for } forall
  /maxfree 0 def 0 1 ncell 1 sub { free exch get maxfree max /maxfree exch def } for
  /spts 6000 array def /nspts 0 def

  % ---------------------------------------------------------- 1. stems
  % three from a root near the corner; x(y) is smooth noise of the height
  /root [ layout 1.0 1.6 R.range 0.75 ] def
  /cx g /colright get 0.47 mul def /amp g /colright get 0.2 mul def
  /mains 3 array def
  /tops [ g /ph get 2.6 sub g /ph get layout 0.6 0.72 R.range mul g /ph get layout 0.36 0.48 R.range mul ] def
  1 1 3 { /k exch def
    /f layout 2 fbm1 def
    /ph layout 0 10 R.range def /lam layout 6 9 R.range def
    /x0 root 0 get k 2 sub 0.25 mul add def
    /y root 1 get def
    /pts [ { y tops k 1 sub get gt { exit } if
        /x y lam div ph add f amp mul cx add k 2 sub 0.35 mul add def
        /x x0 x 0 4 y root 1 get sub smoothstep lerp def
        /x x 0.9 max g /colright get 0.9 sub min def
        [ x y ] /y y 0.25 add def } loop ] def
    mains k 1 sub pts put
    /w0 k 1 eq { 0.085 } { 0.065 } ifelse def
    pts w0 0.028 0.1 gstem
    pts w0 0.028 1 addstem } for
  % the scroll: the root curls into a spiral at the corner
  /turns layout 1.2 1.6 R.range def
  [ 0 1 40 { 40 div /t exch def /a t turns mul 360 mul 90 add def
      /r 1 0.85 t mul sub 1.3 pw 0.55 mul def
      [ root 0 get 0.55 sub r a cos mul sub root 1 get 0.05 add r a sin mul add ] } for ]
  0.06 0.012 0.1 gstem
  % the footer stem: from the root along the bottom, tapering out to a hairline
  /f layout 2 fbm1 def
  /ybase foot 1 get foot 3 get add 2 div 0.05 sub def
  /x root 0 get def
  /footpts [ { x fx1 0.3 sub gt { exit } if
      /u root 0 get dup 1.5 add x smoothstep def
      [ x root 1 get 0.1 add ybase x 3.5 div f 0.22 mul add u lerp ] /x x 0.2 add def } loop ] def
  footpts 0.065 0.01 0.06 gstem
  footpts 0.065 0.012 1 addstem
  % on the last page, branches arch out of the main stems into the space under
  % the text, each ending in a flower
  /leafy 12 array def /nleafy 0 def
  0 1 2 { mains exch get [ exch true ] leafy nleafy 3 -1 roll put /nleafy nleafy 1 add def } for
  /arcs 8 array def /narcs 0 def
  spill null ne {
    /sh spill 3 get spill 1 get sub def
    /nb sh 7 div floor cvi 1 max def
    1 1 nb { /b exch def
      /y0 spill 1 get sh b 0.75 sub mul nb div add def
      /src mains layout 1 3 R.int 1 sub get def
      /best 1e30 def /bi 0 def
      0 1 src length 1 sub { /i exch def src i get 1 get y0 sub abs dup best lt { /best exch def /bi i def } { pop } ifelse } for
      /s0 src bi get def
      /w spill 2 get s0 0 get sub def
      /x3 s0 0 get w layout 0.7 0.88 R.range mul add def
      /y3 spill 3 get 1.4 sub y0 sh nb div layout 0.35 0.6 R.range mul add min def
      s0 0 get s0 1 get  s0 0 get w 0.25 mul add  s0 1 get layout -0.4 0.8 R.range add
        x3 w 0.3 mul sub  y3 layout -1.2 -0.3 R.range add  x3 y3 bezier3 w 0.2 div floor cvi 0 1 sample /pts exch def
      /f layout 2 fbm1 def
      0 1 pts length 1 sub { /i exch def /u i pts length 1 sub div def
        pts i [ pts i get 0 get  pts i get 1 get 0.35 pts i get 0 get 3 div f mul u 180 mul sin mul add ] put } for
      pts 0.06 0.025 0.1 gstem
      pts 0.06 0.025 1 addstem
      leafy nleafy [ pts true ] put /nleafy nleafy 1 add def
      arcs narcs pts put /narcs narcs 1 add def } for } if

  % the header fleuron keeps its spot free
  g /colright get 0.5 sub g /headrule get 0.1 add 0.7 1 disc

  % ---------------------------------------------------------- 2. terminal flowers and ghosts
  /counts MOTIFS length 4 add dict def
  MOTIFS { /name get counts exch 0 put } forall
  counts /snail 0 put counts /bird 0 put
  % the tallest stem ends in the largest flower
  /p mains 0 get dup length 1 sub get def /q mains 0 get dup length 3 sub get def
  p 0 get q 0 get sub p 1 get q 1 get sub norm /hy exch def /hx exch def
  /s 1.75 g /colright get 0.27 mul min def
  /fx p 0 get hx 0.2 mul add def /fy p 1 get hy 0.2 mul add def
  5 fx fy 90 { rng R.fork s NOOPT flower } place
  fx fy 1.05 s mul 0.85 disc
  [ fx fy s ] addbloom
  % the shorter stems end in a lily and a flower; in spring in buds, in autumn gone to seed
  2 1 3 { /k exch def
    /pts mains k 1 sub get def /p2 pts dup length 1 sub get def /q2 pts dup length 3 sub get def
    p2 0 get q2 0 get sub p2 1 get q2 1 get sub norm /ay exch def /ax exch def
    /tip spring 0.5 gt { /bud } { autumn 0.5 gt { /seedhead } { null } ifelse } ifelse def
    k 2 eq {
      /s2 layout 1.0 1.2 R.range def
      tip /bud eq { 5 p2 P ax ay deg { rng R.fork 0.95 s2 mul NOOPT bud } place } {
      tip /seedhead eq { 4 p2 0 get ax 0.15 mul add p2 1 get ay 0.15 mul add 90 { rng R.fork 0.75 s2 mul NOOPT seedhead } place } {
        5 p2 0 get ax 0.25 mul s2 mul add p2 1 get ay 0.25 mul s2 mul add ax ay deg { rng R.fork s2 NOOPT lily } place } ifelse } ifelse
      p2 0 get ax 0.3 mul s2 mul add p2 1 get ay 0.3 mul s2 mul add 0.95 s2 mul 0.85 disc
      counts /lily inc
    } {
      /s3 layout 0.85 1.0 R.range def
      tip /bud eq { 5 p2 P ax ay deg { rng R.fork 0.9 s3 mul NOOPT bud } place } {
      tip /seedhead eq { 4 p2 P 90 { rng R.fork 0.75 s3 mul NOOPT seedhead } place } {
        5 p2 P 90 { rng R.fork s3 NOOPT flower } place [ p2 P s3 ] addbloom } ifelse } ifelse
      p2 P s3 0.85 disc
      counts /flower inc } ifelse } for
  0 1 narcs 1 sub { arcs exch get /pts exch def
    /p pts dup length 1 sub get def /s layout 1.0 1.25 R.range def
    5 p P 90 { rng R.fork s NOOPT flower } place
    p P s 0.85 disc
    counts /flower inc
    [ p P s ] addbloom } for
  % ghosts: large pale flowers behind, given a little room so they show
  /ng layout 1 2 R.int def
  1 1 ng { /k exch def
    /gxp g /colright get layout 0.35 0.65 R.range mul def
    /gyp g /ph get k 1 eq { layout 0.15 0.3 R.range } { layout 0.45 0.6 R.range } ifelse mul def
    /s layout 1.3 1.6 R.range def
    1 gxp gyp 90 { 0.62 { rng R.fork s NOOPT flower } pale } place
    gxp gyp 0.8 s mul 0.6 disc } for

  % ---------------------------------------------------------- marks: a copper flower beside each heading
  % at the column's edge at the height of the heading, on a branch from the
  % nearest stem; shrunk where there is little room, left out where there is none
  g /marks get { /mk exch def
    mk 1 get 1 eq { /m /flower motif def /s 0.95 def } { /m /blossoms motif def /s 0.7 def } ifelse
    /r s m /r get exec def
    /px g /colright get r sub 0.15 sub def /py mk 0 get 0.12 add def
    /f px py freeat def
    f 0.95 r mul lt {
      /lo m /smin get 0.8 mul def /hi s def
      20 { /mid lo hi add 2 div def mid m /r get exec f 0.95 mul gt { /hi mid def } { /lo mid def } ifelse } repeat
      /s lo def /r s m /r get exec def } if
    r f 1.15 mul le py 0.6 r add gt and py g /ph get 0.6 sub r sub lt and {
      px py nearest pop /S exch def
      px S 0 get sub py S 1 get sub norm /dy exch def /dx exch def
      dx dy m /upright 0 opt add norm /ay exch def /ax exch def
      /ox px ax s m /off get exec mul sub def /oy py ay s m /off get exec mul sub def
      S ox oy ax ay 0.045 branchto
      m /layer get ox oy ax ay deg { { rng R.fork s m /draw get exec } inaccent } place   % rubricated, as headings once were
      m /name get /flower eq { [ ox oy s ] addbloom } if
      counts m /name get inc
      px py r 0.85 disc } if } forall

  % ---------------------------------------------------------- visitors on the stems
  % a snail crawling up a main stem, and now and then a bird on a twig of its own
  visiting /snail false opt {
    /s vis 0.75 0.9 R.range def /best -1 def /c null def
    12 { /k vis 1 3 R.int def /pts mains k 1 sub get def
      /i vis 10 pts length 0.15 mul floor cvi max 11 pts length 0.45 mul floor cvi max R.int 1 sub def
      /side vis 0.5 R.chance { 1 } { -1 } ifelse def
      pts i ptangent /ty exch def /tx exch def
      /nx ty side mul def /ny tx neg side mul def          % toward the shell
      /f pts i get 0 get nx 0.8 mul s mul add pts i get 1 get ny 0.8 mul s mul add freeat def
      f best gt { /best f def /c [ k i side nx ny ] def } if } repeat
    c null ne best 0.25 gt and {
      /pts mains c 0 get 1 sub get def /ci c 1 get def /cside c 2 get def /cnx c 3 get def /cny c 4 get def
      6 pts ci get 0 get cnx 0.03 mul add pts ci get 1 get cny 0.03 mul add pts ci ptangent deg
        { cside 1 scale rng R.fork s NOOPT snail } place
      pts ci get 0 get cnx 0.36 mul s mul add pts ci get 1 get cny 0.36 mul s mul add 0.5 s mul 1 disc
      counts /snail 1 put } if } if
  visiting /bird false opt {
    /s vis 2.3 2.7 R.range def /best -1 def /c null def
    24 { /k vis 1 3 R.int def /pts mains k 1 sub get def
      /i vis pts length 0.25 mul floor cvi pts length 0.75 mul floor cvi R.int 1 sub def
      /p pts i get def
      /dir vis 0.5 R.chance { 1 } { -1 } ifelse def
      /L vis 1.2 1.7 R.range def
      /ex p 0 get dir L mul add def /ey p 1 get vis 0.05 0.4 R.range add def
      /bx ex dir 0.25 mul sub def /by ey def
      /facing vis 0.65 R.chance { dir } { dir neg } ifelse def
      /bcx bx facing 0.03 mul s mul add def /bcy by 0.4 s mul add def
      /f bcx bcy freeat 0.36 s mul div  bx facing 0.35 mul s mul sub by 0.15 s mul add freeat 0.2 s mul div min def
      f best gt { /best f def /c [ k i ex ey dir facing bcx bcy ] def } if } repeat
    c null ne best 1 gt and {
      /pts mains c 0 get 1 sub get def /p pts c 1 get get def
      pts c 1 get ptangent /ty exch def /tx exch def
      /twig vis p P tx ty c 2 get c 3 get c 4 get 0.1 branchpath def
      twig 0.05 0.02 0.07 gstem
      twig 0.05 0.02 2 addstem
      /perch twig twig length 0.85 mul floor cvi 1 sub 0 max get def
      /fc c 5 get def
      6 perch P 90 { rng R.fork s 1 dict dup /facing fc put bird } place
      c 6 get c 7 get 0.36 s mul 0.9 disc
      perch 0 get fc 0.35 mul s mul sub perch 1 get 0.15 s mul add 0.2 s mul 0.9 disc
      counts /bird 1 put } if } if

  % ---------------------------------------------------------- 3. leaves at the nodes
  % big stems get full leaves, alternating sides, smaller toward the top; the
  % footer gets leaflets that thin out toward its end
  leafy nleafy [ footpts false ] put /nleafy nleafy 1 add def
  0 1 nleafy 1 sub { leafy exch get aload pop /big exch def /pts exch def
    /s 0 def /acc layout 0.6 1.3 R.range def /side layout 0.5 R.chance { 1 } { -1 } ifelse def
    /total 0 def 1 1 pts length 1 sub { /i exch def /total total pts i get P pts i 1 sub get P dist add def } for
    1 1 pts length 5 sub { /i exch def
      /s s pts i get P pts i 1 sub get P dist add def
      s acc ge {
        /u s total div def
        /acc acc big { layout 1.4 2.2 R.range } { 0.55 1.4 u lerp layout 0.8 1.2 R.range mul } ifelse add def
        /side side neg def
        pts i 1 add get 0 get pts i 1 sub get 0 get sub pts i 1 add get 1 get pts i 1 sub get 1 get sub norm /ty exch def /tx exch def
        /a tx ty deg side layout 35 60 R.range mul add def
        /ux a cos def /uy a sin def
        /Lf big { 2.4 1.3 pts i get 1 get g /ph get div lerp } { 0.95 0.45 u lerp } ifelse layout 0.85 1.1 R.range mul def
        /Lf Lf 0.8 1 1 season mul def                      % young leaves are small
        /ok false def
        3 { pts i get 0 get ux Lf mul 0.55 mul add pts i get 1 get uy Lf mul 0.55 mul add freeat 0.24 Lf mul ge
            { /ok true def exit } if /Lf Lf 0.75 mul def } repeat
        ok Lf big { 0.7 } { 0.3 } ifelse gt and {
          big {
            /lobed layout 0.6 R.chance def
            /bend side layout 0.05 0.3 R.range mul def
            /copper autumn 0 gt { sea 0.35 autumn mul R.chance } { false } ifelse def   % young leaves are pale; in autumn some turn copper
            3 pts i get P a {
              /lf { Lf dup scale rng R.fork 3 dict dup /w layout 0.22 0.3 R.range put
                    dup /depth lobed { layout 0.4 0.8 R.range } { 0 } ifelse put dup /bend bend put leaf } def
              copper { /lf load inaccent } { spring 0 gt { 0.3 spring mul /lf load pale } { lf } ifelse } ifelse } place
          } {
            /bend side neg layout 0.1 0.3 R.range mul def
            3 pts i get P a { Lf dup scale rng R.fork 1 dict dup /bend bend put leaflet } place } ifelse
          [0.3 0.55 0.8] { /ff exch def pts i get 0 get ux Lf mul ff mul add pts i get 1 get uy Lf mul ff mul add 0.24 Lf mul 0.85 disc } forall
        } if } if } for } for

  % ---------------------------------------------------------- 4. branches to the largest holes
  /area 0 rects { aload pop 3 -1 roll sub 3 1 roll exch sub mul add } forall def
  /af area 175 div 1 max def
  /caps MOTIFS length dict def
  MOTIFS { /m exch def caps m /name get m /fly false opt { m /max get } { m /max get af mul 0.5 add floor cvi } ifelse put } forall
  /eligm MOTIFS length array def /eligw MOTIFS length array def
  /nbranch 0 def
  400 {
    /best -1 def /bi -1 def
    0 1 ncell 1 sub { dup sdist exch get REACH le
      { dup free exch get layout 0.85 1.15 R.range mul dup best gt { /best exch def /bi exch def } { pop pop } ifelse } { pop } ifelse } for
    bi 0 lt { exit } if free bi get SMALLEST lt { exit } if
    /f free bi get def /px gx bi get def /py gy bi get def
    % statement motifs have a hard cap; the others only lose weight as they repeat
    /nel 0 def /wsum 0 def
    MOTIFS { /m exch def
      /wt m /w get m /spring 1 opt m /summer 1 opt m /autumn 1 opt season mul
        1 counts m /name get get caps m /name get get 1 max div add div def
      wt 0 gt  m /smin get m /r get exec f 1.05 mul le and
        m /hard false opt not counts m /name get get caps m /name get get lt or and
        m /fly false opt not visiting m /name get false opt or and
      { eligm nel m put eligw nel wt put /nel nel 1 add def /wsum wsum wt add def } if } forall
    nel 0 eq { free bi 0 put } {
      /pick eligm nel 1 sub get def /acc layout R.u wsum mul def
      0 1 nel 1 sub { /k exch def /acc acc eligw k get sub def acc 0 le { /pick eligm k get def exit } if } for
      /s pick /smax get def
      s pick /r get exec f 0.95 mul gt {
        /lo pick /smin get def /hi s def
        20 { /mid lo hi add 2 div def mid pick /r get exec f 0.95 mul gt { /hi mid def } { /lo mid def } ifelse } repeat
        /s lo def } if
      px py nearest /sd exch def /S exch def
      px S 0 get sub py S 1 get sub norm /dy exch def /dx exch def
      dx dy pick /upright 0 opt add norm /ay exch def /ax exch def   % away from the stem, leaning up for the upright kinds
      /ox px ax s pick /off get exec mul sub def /oy py ay s pick /off get exec mul sub def
      /hang pick /hang false opt def
      hang { /ox px dx 0.2 mul s mul sub def /oy py 0.45 s mul add def } if
      /nbranch nbranch 1 add def
      pick /fly false opt {
        % a visitor: no branch, any heading
        /a pick /name get /bee eq { layout 0 360 R.range } { 90 layout 50 R.sym add } ifelse def
        pick /layer get px py a { rng R.fork s pick /draw get exec } place
      } {
        ox oy S 0 get S 1 get dist 0.12 gt { S ox oy hang { dx -0.3 } { ax ay } ifelse 0.04 branchto } if
        pick /layer get ox oy hang { 90 } { ax ay deg } ifelse { rng R.fork s pick /draw get exec } place
        pick /name get /flower eq { [ ox oy s ] addbloom } if } ifelse
      counts pick /name get inc
      px py s pick /r get exec 0.85 disc } ifelse } repeat

  % autumn: loose petals fall from the flowers into the free space below them
  autumn 0 gt {
    0 1 nblooms 1 sub { blooms exch get /b exch def
      sea 0 3 autumn mul 0.5 add floor cvi R.int {
        /best 0.16 def /bx null def
        6 { /x b 0 get sea 1.1 R.sym add def /y b 1 get b 2 get sub sea 0.1 2.2 R.range sub def
            /f x y freeat def f best gt { /best f def /bx x def /by y def } if } repeat
        bx null ne {
          /ps sea 0.4 0.6 R.range def /pa sea 0 360 R.range def /pt sea 0.36 0.5 R.range def
          5 bx by pa { ps dup scale rng R.fork 2 dict dup /tone pt put dup /heart false put petal } place
          bx by 0.22 1 disc } if } repeat } for } if

  % ---------------------------------------------------------- 5. small holes
  % only right next to a stem, and not too many: a pair of leaflets at a node,
  % a bud, or a few florets. Far from any stem, a copper accent or nothing.
  /accents 0 def /fills 0 def /maxfill 28 af mul floor cvi def
  600 {
    /best -1 def /bi -1 def
    0 1 ncell 1 sub { dup free exch get layout 0.85 1.15 R.range mul dup best gt { /best exch def /bi exch def } { pop pop } ifelse } for
    bi 0 lt { exit } if free bi get FILLMIN lt { exit } if
    /f free bi get def /px gx bi get def /py gy bi get def
    px py nearest /sd exch def /S exch def
    sd 0.75 lt fills maxfill lt and {
      /fills fills 1 add def
      px S 0 get sub py S 1 get sub norm /dy exch def /dx exch def
      dx dy 0.4 add norm /ay exch def /ax exch def
      /kind layout R.u def
      kind 0.4 lt {                                        % two leaflets in a V at the stem point
        /base ax ay deg def /ls 0.75 f 1.6 mul min def
        [-1 1] { /kk exch def /a base kk layout 20 35 R.range mul add def
          3 S 0 get S 1 get a { ls layout 0.8 1 R.range mul dup scale rng R.fork 1 dict dup /bend kk neg 0.15 mul put leaflet } place } forall
      } { kind 0.65 lt {                                   % a bud on a hairline stalk
        /ox px ax f mul 0.5 mul sub def /oy py ay f mul 0.5 mul sub def
        2 layer
        S 0 get S 1 get moveto S 0 get S 2 get 0.15 mul add S 1 get S 3 get 0.15 mul add ox ax 0.1 mul sub oy ay 0.1 mul sub ox oy curveto
        0.1 tone 0.4 strokec
        5 ox oy ax ay deg { rng R.fork 0.6 f 1.7 mul min NOOPT bud } place
      } {                                                  % a small cluster of florets
        layout 2 4 R.int {
          /qx px layout f 0.5 mul R.sym add def /qy py layout f 0.5 mul R.sym add def
          2 layer
          S 0 get S 1 get moveto S 0 get S 2 get 0.1 mul add S 1 get S 3 get 0.1 mul add
            S 0 get qx add 2 div S 1 get qy add 2 div 0.05 add qx qy curveto
          0.12 tone 0.25 0.9 strokea
          5 qx qy 90 { rng R.fork 0.11 f 0.6 mul min layout 0.8 1.1 R.range mul NOOPT floret } place } repeat
      } ifelse } ifelse
    } {
      sd 0.75 ge accents 6 lt and f 0.22 gt and px g /colright get lt and {
        /accents accents 1 add def
        layout 0.6 R.chance { 6 px py 90 { rng R.fork 0.13 NOOPT sparkle } place }
                            { 6 px py 90 { rng R.fork 0.12 NOOPT rosette } place } ifelse } if
    } ifelse
    px py f 0.3 max 1 disc } repeat

  % ---------------------------------------------------------- 6. the footer's tail
  /e footpts dup length 1 sub get def
  /x2 e 0 get layout 1.6 2.2 R.range add def
  6 layer
  e P moveto e 0 get 0.6 add e 1 get 0.05 add x2 0.6 sub e 1 get 0.05 sub x2 e 1 get curveto 0 accent 0.3 0.8 strokea
  6 x2 0.18 add e 1 get 90 { rng R.fork 0.12 1 dict dup /rays false put sparkle } place
  x2 0.45 add e 1 get 0.025 circle 0 accent fillc

  % a safety clip a little outside the regions, around all the layers
  0 layer
  rects { /r exch def /rx r col eq { 0.25 } { 0.3 } ifelse def
    [ [ r 0 get 0.25 sub r 1 get 0.3 sub ] [ r 2 get rx add r 1 get 0.3 sub ] [ r 2 get rx add r 3 get 0.3 add ] [ r 0 get 0.25 sub r 3 get 0.3 add ] ] true poly } forall
  iclip
  99 layer iunclip
  5 layer
  /nmotif 0 counts { exch pop add } forall def
  (%stderr) (w) file dup
  [ (florilegium: page seed ) g /seed get (, ) ncell ( cells, ) nmotif ( motifs, ) nspts ( stem points; visitors:) ]
  { dup type /stringtype ne { 20 string cvs } if writestring dup } forall
  [ /butterfly /bee /snail /bird ] { dup counts exch get dup 0 gt
    { 2 index ( ) writestring 2 index exch 20 string cvs writestring 1 index ( ) writestring 1 index exch 20 string cvs writestring }
    { pop pop } ifelse } forall
  (\n) writestring pop
  end } bind def

% ================================================================ the document
% The page describes itself. The text is set first, without painting, to
% learn where each heading falls and where the text ends; then each page's
% garden grows around it, is painted, and the text is set on top.
/latin1 { exch findfont dup length dict begin { 1 index /FID ne { def } { pop pop } ifelse } forall   % font newname -> font
  /Encoding ISOLatin1Encoding 256 array copy dup 45 /hyphen put def   % ISOLatin1Encoding has /minus there
  currentdict end definefont } bind def
/F.roman /Times-Roman /Times-Roman-L1 latin1 10.5 scalefont def
/F.ital /Times-Italic /Times-Italic-L1 latin1 10.5 scalefont def
/F.bold /Times-Bold /Times-Bold-L1 latin1 12 scalefont def
/F.title /Times-Bold /Times-Bold-L1 latin1 19 scalefont def
/F.small /Times-Italic /Times-Italic-L1 latin1 9.5 scalefont def
/F.folio /Times-Roman /Times-Roman-L1 latin1 10 scalefont def
/F.mono /Courier /Courier-L1 latin1 9.5 scalefont def

% the page (A4, cm from the lower-left corner) and the text block in it
/PW 21.0 def /PH 29.7 def
/TEXTLEFT 6.8 def /TEXTRIGHT 18.8 def /YTOP 26.5 def /YBOTTOM 3.0 def
/COLRIGHT TEXTLEFT 0.4 sub def /HEADRULE YTOP 0.7 add def /FOOTY YBOTTOM 1.05 sub def
/TL TEXTLEFT CM mul def /TW TEXTRIGHT TEXTLEFT sub CM mul def
/YT YTOP CM mul 10 sub def /YB YBOTTOM CM mul def
/LEAD 13.2 def

/LINES 400 array def /NL 0 def /MARKS 40 array def /NM 0 def /PG 1 def /TY YT def
/strcat { 3 dict begin /b exch def /a exch def /s a length b length add string def s 0 a putinterval s a length b putinterval s end } bind def
/words { [ exch { ( ) search { exch pop dup length 0 eq { pop } { exch } ifelse } { dup length 0 eq { pop } if exit } ifelse } loop ] } bind def
/newpage { /PG PG 1 add store /TY YT store } bind def
/addline { LINES NL 3 -1 roll put /NL NL 1 add store } bind def   % [page x y font words extra] ->
% a paragraph: string font indent mode (/justify, /center or /left)
/par { 20 dict begin /mode exch def /ind exch def /fnt exch def words /ws exch def
  fnt setfont /spw ( ) stringwidth pop def
  /i 0 def /first true def
  { i ws length ge { exit } if
    /x0 first { ind } { 0 } ifelse def /lw TW x0 sub def
    /j i def /w 0 def
    { j ws length ge { exit } if
      /nw ws j get stringwidth pop j i gt { w spw add add } if def
      nw lw gt j i gt and { exit } if
      /w nw def /j j 1 add def } loop
    /extra mode /justify eq j ws length lt and { lw w sub j i sub 1 sub 1 max div } { 0 } ifelse def
    extra spw 1.6 mul gt { /extra 0 def } if               % rather ragged than gappy
    TY YB lt { newpage } if
    [ PG mode /center eq { TW w sub 2 div } { x0 } ifelse TL add TY fnt ws i j i sub getinterval extra ] addline
    /TY TY LEAD sub store
    /i j def /first false def } loop
  end } bind def
/heading { /h.s exch def                                   % string -> a section heading, kept with what follows
  TY 4 LEAD mul sub YB lt { newpage } { TY YT lt { /TY TY 8 sub store } if } ifelse
  [ PG TL TY F.bold [ h.s ] 0 ] addline
  MARKS NM [ PG TY CM div 2 ] put /NM NM 1 add store
  /TY TY LEAD sub 4 sub store } bind def
/title { /t.s exch def F.title setfont /TY TY 8 sub store   % string -> centered, large
  [ PG TW t.s stringwidth pop sub 2 div TL add TY F.title [ t.s ] 0 ] addline
  /TY TY 24 sub store } bind def

/body { F.roman 0 /justify par } bind def
/body2 { F.roman 14 /justify par } bind def                % an indented paragraph
/code { /c.s exch def TY YB lt { newpage } if               % string -> one line of code, as it is
  [ PG TL 14 add TY F.mono [ c.s ] 0 ] addline /TY TY 11.5 sub store } bind def
/DOC {
  (A garden grown in PostScript) title
  (Every petal, leaf and stem in the margin was computed by the PostScript interpreter that printed this page. Nothing was drawn beforehand: change the seed and a different garden grows. This one is seed ) SEED 12 string cvs strcat (.) strcat F.ital 0 /center par
  /TY TY 8 sub store
  (1  Painting a petal) heading
  (A petal is a closed outline around a curved spine: a half-width on each side, an edge that wobbles with one-dimensional gradient noise, and the points joined by Catmull-Rom curves turned into B\351zier segments. It is painted the way a watercolor is, inside a clip of its own outline. First a flat wash. Then a dozen irregular blotches at 10 to 25 percent opacity, the darker ones multiplied, so they deepen where they overlap. Then the outline stroked again, wide and dark, so that only its inner half shows, like pigment pooling at the edge of a wash. Last, white streaks fanning out from the base, lifted out at 55 to 90 percent. There are no outlines; the edges come from the wash.) body
  (A flower is five petals, a white star at the heart, stamens and a copper eye. Leaves, buds, bells, lilies, sprays, seed heads and the occasional butterfly, bee, snail or bird are built the same way, each in its own coordinate frame with its own random stream, so that no two are alike.) body2
  (2  Growing the margin) heading
  (Three stems rise from a root in the bottom-left corner. The x of each is smooth noise of its height, so they sway and cross now and then; the tallest ends in the largest flower. Leaves hang at their nodes, alternating sides, smaller toward the top. Then a greedy loop fills the column. A grid of 2 mm cells holds, for each cell, the radius of the largest empty disc around it. The loop takes the largest disc within 3 cm of a stem, picks a motif that fits it, weighted against what has been drawn already, scales it to the disc and grows a branch to it from the nearest stem point: a B\351zier curve that leaves along the stem and arrives along the motif's axis, so every flower can be traced back to the root.) body
  (The motif's disc and the branch's points go back into the grid, and the loop repeats until no free disc is left with a radius over 3.6 mm. Those get leaflets, buds and florets when a stem is near, a copper sparkle when it is not. The headings of this text are known before the garden grows, so each one gets a spray of copper blossoms beside it, where there is room.) body2
  (3  What PostScript gives for free) heading
  (Nearly all of it maps onto the language. The current transformation matrix is the turtle: each primitive draws in its own frame, and translate, rotate and scale put it in place. Paths are paths, and curves are B\351zier curves already. Procedures are data that can be built while the program runs, so the half-width of a petal is a procedure handed to the code that builds outlines, and a branch is a procedure that evaluates its own curve. The random numbers come from a Park-Miller generator in 32-bit integer arithmetic, which every interpreter does exactly.) body
  (4  What it does not) heading
  (Layers. The garden grows in one order and must be painted in another: ghost flowers behind the stems, stems behind the leaves, flowers on top. So nothing is painted while it grows. Each fill and stroke is captured with pathforall into one of six lists, and the lists are played back at the end.) body
  (Transparency. PostScript has none, and the watercolor look depends on it. Ghostscript has it as an extension, switched on by the first option in the command below. Without that, or on a printer, each translucent fill is mixed with the color it is likely to land on and painted opaque: flatter, but the same garden.) body2
  (Free space. The text is laid out before anything is drawn, so the garden knows where the headings are and where the text ends, and on the last page it fills the space below.) body2
  (5  Running it) heading
  (The file is plain PostScript and needs nothing else. With Ghostscript:) body
  /TY TY 2 sub store
  (gs -dALLOWPSTRANSPARENCY -sDEVICE=pdfwrite \\) code
  (   -dSeed=7 -o garden.pdf florilegium.ps) code
  /TY TY 3 sub store
  (Any positive seed works; without one the clock chooses, so every print grows a new garden. -dAge=0 gives spring and -dAge=1 autumn, and -dNoVisitors keeps the insects, the snail and the bird away. The constants that shape the growth have names near the start of the growth section: the size of a grid cell, the reach of a branch, the smallest hole worth filling. Everything else follows the Lua code that draws the same margins in LuaLaTeX, procedure for procedure.) body
} def

/folio { F.folio setfont DEF setmatrix 0 setgray           % page -> the number at the bottom right
  12 string cvs dup stringwidth pop TEXTRIGHT CM mul exch sub FOOTY CM mul moveto show } bind def
/runninghead { F.small setfont DEF setmatrix 0 setgray
  (A garden grown in PostScript) dup stringwidth pop TEXTRIGHT CM mul exch sub HEADRULE 0.16 add CM mul moveto show } bind def
/paintlines { /pl.p exch def DEF setmatrix 0 setgray       % page ->
  0 1 NL 1 sub { LINES exch get dup 0 get pl.p eq {
      aload pop /pl.extra exch def /pl.ws exch def setfont moveto pop
      pl.ws { show ( ) stringwidth pop pl.extra add 0 rmoveto } forall } { pop } ifelse } for } bind def
% the header: a copper ivy leaf whose stem becomes the head rule
/pagehead { 4 dict begin /rng exch def                     % rng ->
  DEF setmatrix CM dup scale 5 layer
  ipush COLRIGHT 0.55 sub HEADRULE 0.02 add translate rng 0.36 NOOPT hedera ipop /hy exch def /hx exch def
  hx hy moveto hx 1.0 add hy hx 1.5 add HEADRULE hx 2.5 add HEADRULE curveto TEXTRIGHT HEADRULE lineto 0 accent 0.4 strokec
  TEXTRIGHT HEADRULE 0.03 circle 0 accent fillc end } bind def
% MaxBitmap (Ghostscript only): 10.05 crashes on the second page when a
% rasterizer bands a page that pushed its transparency compositor; unbanded it doesn't
/startpage {
  << /PageSize [PW CM mul PH CM mul] TRANSP { /MaxBitmap 1000000000 } if >> setpagedevice
  /DEF matrix defaultmatrix store
  /DETDEF DEF dup 0 get 1 index 3 get mul exch dup 1 get exch 2 get mul sub abs store
  /.pushpdf14devicefilter where { pop 0 .pushpdf14devicefilter } if
  DEF setmatrix CM dup scale } bind def
/endpage { /.poppdf14devicefilter where { pop .poppdf14devicefilter } if showpage } bind def

% The clock, when no seed is given. Ghostscript's realtime counts milliseconds
% from the interpreter's start (about 20 by the time this runs), so alone it
% picks one of a handful of gardens. The %Calendar% device of Level 2 has the
% date and time to the second; an interpreter without one (or with its clock
% not running) falls back to realtime, whose origin each interpreter chooses.
/clockseed {                                               % -> seed in 1..99991
  mark { (%Calendar%) currentdevparams } stopped { cleartomark null } { exch pop } ifelse
  dup type /dicttype eq { dup /Running known { dup /Running get } { false } ifelse } { false } ifelse
  { 0 exch [ /Year /Month /Day /Hour /Minute /Second ]
    { 1 index exch get 3 -1 roll 61 mul add 99991 mod exch } forall pop }
  { pop realtime abs 99991 mod } ifelse
  1 add } bind def

% Options. A number may come as an integer, a real or a string of digits;
% anything else (true from a bare -dSeed or -dAge) counts as not given.
/optnum {                                                  % value default -> number
  exch dup type /stringtype eq
  { mark exch { token { exch pop } { null } ifelse } stopped { cleartomark null } { exch pop } ifelse } if
  dup type dup /integertype eq exch /realtype eq or { exch } if pop } bind def
/optbool { dup type /booleantype ne { 0 optnum 0 ne } if } bind def   % value -> bool
% Seeds stay at or below SEEDMAX so that seed * 7919 (+ 7907 a page) fits in
% 32 bits: an interpreter with 32-bit integers, the size the PostScript
% reference gives them, turns a larger product into a single-precision real,
% which would grow a different garden from the same seed than Ghostscript's
% 64-bit integers do.
/SEEDMAX 250000 def
/seedof {                                                  % option -> 0 (none: the clock) or 1..SEEDMAX
  0 optnum abs
  dup 2147483647 gt { dup SEEDMAX div floor SEEDMAX mul sub abs floor dup 0 eq { pop SEEDMAX } if } if
  cvi dup 0 ne { 1 sub SEEDMAX mod 1 add } if } bind def

% -dFloCheck adds a line to stderr after each page with a checksum of all it
% painted (the captured layers, before they run): numbers to 0.01, operators
% and names by their text. check.sh compares it with expected.txt.
/SUM 0 def /SBUF 64 string def
/sumin { SUM 61 mul add 33554393 mod dup 0 lt { 33554393 add } if /SUM exch store } bind def   % int ->
/sumof {                                                   % any ->
  dup type dup /integertype eq exch /realtype eq or { 100 mul round cvi sumin } {
  dup type dup /arraytype eq exch /packedarraytype eq or { dup length sumin { sumof } forall } {
  SBUF cvs { sumin } forall } ifelse } ifelse } bind def
/sumlayers { CHECK {
  LAYERS { dup null ne { dup /a get exch /n get 0 exch getinterval { sumof } forall } { pop } ifelse } forall
  } if } bind def
/sumline { CHECK {
  (%stderr) (w) file dup (florilegium: page ) writestring dup page SBUF cvs writestring
  dup ( drawing ) writestring dup SUM SBUF cvs writestring (\n) writestring } if } bind def

/main {
  /SEED Seed seedof dup 0 eq { pop clockseed } if store
  /AGE Age -1 optnum dup 0 lt { pop -1 } { 0 1 clamp } ifelse store
  /VISIT NoVisitors optbool not store
  /CHECK FloCheck optbool store
  DOC
  1 1 PG { /page exch store
    startpage /SUM 0 store
    /gseed SEED page 1 sub 7907 mul add store
    /lasty 1e30 store 0 1 NL 1 sub { LINES exch get dup 0 get page eq { 2 get lasty min /lasty exch store } { pop } ifelse } for
    <<
      /seed gseed /pw PW /ph PH /textleft TEXTLEFT /textright TEXTRIGHT /ybot YBOTTOM
      /colright COLRIGHT /headrule HEADRULE /footy FOOTY
      /spill page PG eq { 1 } { 0 } ifelse /spilly lasty 3 sub CM div
      /marks [ 0 1 NM 1 sub { MARKS exch get dup 0 get page eq { 1 2 getinterval } { pop } ifelse } for ]
      /age AGE /visitors VISIT
    >> growpage
    sumlayers paintlayers
    gseed 3 add R.new pagehead sumlayers paintlayers
    page paintlines
    page 1 gt { runninghead } if
    page folio
    sumline
    endpage } for } bind def
/SEED 1 def /page 1 def /gseed 1 def /lasty 0 def
/AGE -1 def /VISIT true def /CHECK false def

end   % florilegium

% ---------------------------------------------------------------- the pages
/FloNoPage where { pop } { florilegium begin main end } ifelse
%%EOF
